---
import { PortableText } from 'astro-portabletext';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsArticleCard from '../../components/NewsArticleCard.astro';
import SanityArticleImage from '../../components/SanityArticleImage.astro';
import { contentTypeLabel, formatNewsDate, getNewsArticles, getNewsImageUrl, type NewsArticle } from '../../lib/sanity';

export async function getStaticPaths() {
  const articles = await getNewsArticles();
  return articles.map((article) => ({ params: { slug: article.slug }, props: { article, articles } }));
}

interface Props { article: NewsArticle; articles: NewsArticle[]; }
const { article, articles } = Astro.props;
const coverUrl = getNewsImageUrl(article.coverImage, 1600, 900) ?? undefined;
const related = articles.filter((item) => item._id !== article._id && item.category?.slug === article.category?.slug).slice(0, 3);
const description = article.seo?.description || article.excerpt;
const title = article.seo?.title || article.title;
const portableComponents = { type: { articleImage: SanityArticleImage } };
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: article.title,
  description,
  datePublished: article.publishedAt,
  dateModified: article.updatedAt ?? article.publishedAt,
  image: coverUrl,
  author: { '@type': 'Person', name: article.author?.name ?? 'GROWCHILD Editorial Team' },
  publisher: { '@type': 'Organization', name: 'GROWCHILD', url: 'https://growchild-initiative.ifexls.chatgpt.site' },
};
---

<BaseLayout title={title} description={description} image={coverUrl} ogType="article" publishedTime={article.publishedAt}>
  <article>
    <header class="article-header">
      <div class="container article-heading">
        <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/news/">News &amp; Updates</a><span aria-hidden="true">/</span><span aria-current="page">{article.title}</span></nav>
        <div class="article-kicker"><span>{article.category?.title ?? contentTypeLabel(article.contentType)}</span><time datetime={article.publishedAt}>{formatNewsDate(article.publishedAt)}</time></div>
        <h1>{article.title}</h1>
        <p class="article-excerpt">{article.excerpt}</p>
        <div class="byline"><strong>{article.author?.name ?? 'GROWCHILD Editorial Team'}</strong>{article.author?.role && <span>{article.author.role}</span>}</div>
      </div>
    </header>
    {coverUrl && <figure class="cover-image container">
      <img src={coverUrl} alt={article.coverImage.alt ?? ''} width="1600" height="900" fetchpriority="high" decoding="async" />
      {(article.coverImage.caption || article.coverImage.credit) && <figcaption>{article.coverImage.caption}{article.coverImage.caption && article.coverImage.credit && ' · '}{article.coverImage.credit && (article.coverImage.sourceUrl ? <a href={article.coverImage.sourceUrl} rel="license noopener">{article.coverImage.credit}</a> : article.coverImage.credit)}</figcaption>}
    </figure>}
    <div class="container article-layout">
      <div class="article-body">{article.body && <PortableText value={article.body} components={portableComponents} />}</div>
      <aside aria-label="Article information"><span class="eyebrow">About this update</span><dl><div><dt>Published</dt><dd>{formatNewsDate(article.publishedAt)}</dd></div><div><dt>Type</dt><dd>{contentTypeLabel(article.contentType)}</dd></div>{article.category && <div><dt>Category</dt><dd>{article.category.title}</dd></div>}</dl><a class="button button-secondary" href="/contact/">Contact GROWCHILD</a></aside>
    </div>
  </article>
  {related.length > 0 && <section class="section section-tint"><div class="container"><span class="eyebrow">Continue reading</span><h2 class="related-title">Related updates</h2><div class="related-grid">{related.map((item) => <NewsArticleCard article={item} />)}</div></div></section>}
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
</BaseLayout>

<style>
  .article-header { padding-block: clamp(3.5rem,8vw,6rem); color: var(--white); background: linear-gradient(125deg,#063719,var(--deep-green)); }
  .article-heading { max-width: 58rem; }
  .article-heading h1 { max-width: 52rem; color: var(--white); }
  .article-kicker { display: flex; flex-wrap: wrap; gap: .75rem 1.25rem; margin-bottom: 1.25rem; color: rgba(255,255,255,.82); font-size: .95rem; }
  .article-kicker span { color: #d4ffb3; font-family: var(--font-heading); font-weight: 700; text-transform: uppercase; }
  .article-excerpt { max-width: 48rem; margin-top: 1.25rem; color: rgba(255,255,255,.9); font-size: clamp(1.15rem,2vw,1.35rem); }
  .byline { display: flex; flex-wrap: wrap; gap: .35rem 1rem; margin-top: 1.5rem; color: rgba(255,255,255,.8); font-size: .95rem; }
  .byline strong { color: var(--white); }
  .cover-image { margin-top: clamp(-2.5rem,-4vw,-1.5rem); position: relative; }
  .cover-image img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border: .5rem solid var(--white); border-radius: 1rem; box-shadow: var(--shadow-soft); }
  .cover-image figcaption { margin-top: .5rem; color: #667068; font-size: .85rem; }
  .cover-image a { text-underline-offset: .15rem; }
  .article-layout { display: grid; grid-template-columns: minmax(0, 46rem) minmax(14rem, 18rem); justify-content: center; gap: clamp(2rem,6vw,5rem); padding-block: clamp(3.5rem,8vw,6rem); }
  .article-body { min-width: 0; font-size: 1.12rem; }
  .article-body :global(> * + *) { margin-top: 1.25rem; }
  .article-body :global(h2), .article-body :global(h3) { margin-top: 2.25rem; }
  .article-body :global(a) { color: var(--deep-blue); text-underline-offset: .2rem; }
  .article-body :global(blockquote) { margin-inline: 0; padding: 1.5rem; color: var(--deep-green); border-left: 5px solid var(--leaf-green); background: var(--surface-tint); font: 600 1.2rem/1.55 var(--font-heading); }
  aside { align-self: start; display: grid; gap: 1.25rem; padding: 1.4rem; border: 1px solid var(--border); border-radius: .75rem; background: var(--surface-tint); }
  dl, dl div { display: grid; gap: .25rem; }
  dl { gap: 1rem; margin: 0; }
  dt { color: #657067; font-size: .82rem; text-transform: uppercase; }
  dd { margin: 0; color: var(--deep-green); font-weight: 700; }
  .related-title { margin: .6rem 0 1.5rem; }
  .related-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1.25rem; }
  @media (max-width: 55rem) { .article-layout { grid-template-columns: 1fr; } aside { grid-template-columns: 1fr 1fr; } aside .button { grid-column: 1 / -1; width: fit-content; } .related-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 42rem) { .article-body { font-size: 1rem; } aside, .related-grid { grid-template-columns: 1fr; } aside .button { grid-column: auto; } }
</style>

