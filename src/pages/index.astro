---
import BaseLayout from "../layouts/BaseLayout.astro";
import HumanitarianIcon from "../components/HumanitarianIcon.astro";
import EditorialPhoto from "../components/EditorialPhoto.astro";
import { photos } from "../data/photos";

const focusAreas = [
  { title: "Disability Inclusion & Advocacy", icon: "People-with-physical-impairments", sdg: "SDG 10", color: "#DD1367" },
  { title: "Education & Child Protection", icon: "Child-protection", sdg: "SDG 4", color: "#C5192D" },
  { title: "Health & Community Wellbeing", icon: "Health", sdg: "SDG 3", color: "#4C9F38" },
  { title: "Livelihoods & Women's Empowerment", icon: "Livelihood", sdg: "SDG 5", color: "#FF3A21" },
  { title: "Water, Sanitation & Hygiene (WASH)", icon: "Water-Sanitation-and-Hygiene", sdg: "SDG 6", color: "#26BDE2" },
  { title: "Emergency Response", icon: "Response", sdg: "SDG 11", color: "#FD9D24" },
];

const approaches = [
  { title: "MEAL & Evidence-Driven", text: "Strengthens how programmes generate, manage, analyze and use evidence.", icon: "Monitoring" },
  { title: "Community-Based", text: "Programmes grounded in community realities and local ownership.", icon: "Community-engagement" },
  { title: "Women & Youth-Led", text: "Inclusive decision-making, youth participation and community ownership.", icon: "Gender" },
];
---

<BaseLayout title="Inclusion, Dignity and Resilience" description="GROWCHILD is a Nigerian women and youth-led humanitarian and development organization advancing inclusion, dignity and resilience.">
  <section class="home-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Inclusion · Dignity · Resilience</span>
        <h1>Empowering women and children across Nigeria.</h1>
        <p>Community-driven, evidence-based programmes that advance wellbeing, protection, inclusion and resilience.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="/partnerships/">Get Involved</a>
          <a class="button button-secondary" href="/our-work/">Explore Our Work</a>
        </div>
      </div>
      <EditorialPhoto photo={photos.womenMarket} ratio="portrait" eager class="home-hero-photo" />
    </div>
  </section>

  <section class="section">
    <div class="container story-grid">
      <div><span class="eyebrow">Who we are</span><h2>A locally led organization built around dignity.</h2></div>
      <div class="story-copy">
        <p>GROWCHILD is a Nigerian women and youth-led humanitarian and development organization committed to improving the wellbeing, dignity, protection, inclusion and resilience of vulnerable populations.</p>
        <p>Conceptualized in 2017 as a grassroots response to challenges facing women, children and vulnerable households in crisis-affected communities, it was formally registered with the Corporate Affairs Commission in 2026 (RC 9704884).</p>
        <a class="text-link" href="/about/">Read our story →</a>
      </div>
    </div>
    <div class="container story-photo"><EditorialPhoto photo={photos.ruralWomen} ratio="wide" /></div>
  </section>

  <section class="section section-tint">
    <div class="container">
      <div class="section-heading"><span class="eyebrow">What we do</span><h2>Six connected areas of action.</h2></div>
      <div class="focus-grid">
        {focusAreas.map((area, index) => (
          <a class="focus-card" href={`/our-work/#area-${index + 1}`} style={`--sdg-color:${area.color}`}>
            <div class="focus-card-top"><HumanitarianIcon name={area.icon} color={area.color} /><span><span class="sdg-label">{area.sdg}</span><span aria-hidden="true">0{index + 1}</span></span></div>
            <h3>{area.title}</h3>
            <span class="focus-link">Learn more <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container approach-wrap">
      <div class="section-heading"><span class="eyebrow">Our approach</span><h2>Evidence and local ownership guide every programme.</h2></div>
      <div class="cards">
        {approaches.map((approach) => <article class="card card-accent icon-card"><HumanitarianIcon name={approach.icon} /><div><h3>{approach.title}</h3><p>{approach.text}</p></div></article>)}
      </div>
      <a class="text-link approach-link" href="/our-approach/">See how we work →</a>
    </div>
  </section>

  <section class="partnership-banner">
    <div class="container banner-inner">
      <div><span class="eyebrow">Work with us</span><h2>Partner with us to build resilient communities.</h2></div>
      <a class="button banner-button" href="/partnerships/">Become a Partner</a>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero { overflow: hidden; padding-block: clamp(4rem,8vw,7.5rem); background: radial-gradient(circle at 16% 20%,rgba(83,152,25,.14),transparent 24rem), linear-gradient(180deg,#f7faf5,#fff); }
  .hero-grid { display: grid; grid-template-columns: 1.05fr .95fr; align-items: center; gap: clamp(2.5rem,7vw,6.5rem); }
  .hero-copy { display: grid; justify-items: start; gap: 1.45rem; }
  .hero-copy h1 { max-width: 12ch; }
  .hero-copy p { max-width: 38rem; color: var(--slate-grey); font-size: clamp(1.15rem,2vw,1.4rem); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .75rem; }
  :global(.home-hero-photo) { min-height: 31rem; }
  :global(.home-hero-photo img) { object-position: center; }
  .story-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(2rem,7vw,6rem); }
  .story-grid h2, .section-heading h2 { margin-top: 1rem; }
  .story-copy { display: grid; gap: 1.25rem; }
  .story-photo { margin-top: clamp(2.5rem,6vw,5rem); }
  .section-heading { max-width: 47rem; margin-bottom: 2.5rem; }
  .focus-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1rem; }
  .focus-card { position: relative; display: grid; min-height: 15rem; align-content: space-between; gap: 1rem; padding: 1.75rem; overflow: hidden; color: var(--slate-grey); border: 1px solid var(--border); border-top: 4px solid var(--sdg-color); border-radius: .75rem; background: var(--white); box-shadow: 0 8px 22px rgba(10,72,35,.04); text-decoration: none; transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease; }
  .focus-card::after { content: ""; position: absolute; inset: auto -2.5rem -3.5rem auto; width: 8rem; aspect-ratio: 1; border-radius: 50%; background: color-mix(in srgb, var(--sdg-color) 11%, transparent); transform: scale(.78); transition: transform 240ms ease, opacity 240ms ease; }
  .focus-card:hover, .focus-card:focus-visible { border-color: var(--sdg-color); box-shadow: 0 18px 38px color-mix(in srgb, var(--sdg-color) 18%, transparent); transform: translateY(-6px); }
  .focus-card:hover::after, .focus-card:focus-visible::after { transform: scale(1); }
  .focus-card h3, .focus-card-top, .focus-link { position: relative; z-index: 1; }
  .focus-card-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
  .focus-card-top > span { display: grid; justify-items: end; color: var(--sdg-color); font-family: Poppins,Arial,sans-serif; font-size: .85rem; font-weight: 700; letter-spacing: .12em; }
  .sdg-label { font-size: .68rem; letter-spacing: .08em; }
  .focus-link { display: inline-flex; align-items: center; gap: .45rem; color: var(--sdg-color); font-family: Poppins,Arial,sans-serif; font-size: .92rem; font-weight: 700; }
  .focus-link span { transition: transform 180ms ease; }
  .focus-card:hover .focus-link span, .focus-card:focus-visible .focus-link span { transform: translateX(.3rem); }
  .icon-card { display: grid; grid-template-columns: auto 1fr; align-items: start; gap: 1.25rem; }
  .approach-wrap { display: grid; }
  .card p { margin-top: .85rem; }
  .approach-link { margin-top: 2rem; justify-self: start; }
  .partnership-banner { padding-block: 4.5rem; color: var(--white); background: var(--deep-blue); }
  .banner-inner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .partnership-banner .eyebrow, .partnership-banner h2 { color: var(--white); }
  .partnership-banner .eyebrow::before { background: var(--white); }
  .partnership-banner h2 { max-width: 20ch; margin-top: .75rem; }
  .banner-button { flex: 0 0 auto; color: var(--deep-blue); background: var(--white); }
  @media (max-width: 56rem) { .hero-grid, .story-grid { grid-template-columns: 1fr; } :global(.home-hero-photo) { min-height: 23rem; } .focus-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 42rem) { .focus-grid { grid-template-columns: 1fr; } .focus-card { min-height: 12rem; } .banner-inner { align-items: flex-start; flex-direction: column; } }
  @media (prefers-reduced-motion: reduce) { .focus-card:hover, .focus-card:focus-visible, .focus-card:hover::after, .focus-card:focus-visible::after { transform: none; } }
</style>
