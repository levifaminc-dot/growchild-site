---
import BaseLayout from "../layouts/BaseLayout.astro";
import EditorialPhoto from "../components/EditorialPhoto.astro";
import { photos } from "../data/photos";

const trustPoints = [
  { value: "6", label: "Programme areas" },
  { value: "2017", label: "Grassroots beginnings" },
  { value: "RC 9704884", label: "CAC registered" },
  { value: "Nigeria", label: "Locally led" },
];

const focusAreas = [
  { title: "Disability Inclusion & Advocacy", sdg: "SDG 10", color: "#DD1367", text: "Inclusive programming, accessibility, advocacy and meaningful participation for persons with disabilities." },
  { title: "Education & Child Protection", sdg: "SDG 4", color: "#C5192D", text: "Inclusive and safe learning, child protection and stronger community participation in education." },
  { title: "Health & Community Wellbeing", sdg: "SDG 3", color: "#4C9F38", text: "Health awareness, referral pathways and practical support that improves access to essential care." },
  { title: "Livelihoods & Women's Empowerment", sdg: "SDG 5", color: "#FF3A21", text: "Women's empowerment, inclusive livelihoods and stronger household and community resilience." },
  { title: "Water, Sanitation & Hygiene (WASH)", sdg: "SDG 6", color: "#26BDE2", text: "Hygiene awareness, safer practices and improved access to water, sanitation and hygiene." },
  { title: "Emergency Response", sdg: "SDG 11", color: "#FD9D24", text: "Protection-sensitive, accountable and evidence-driven support for crisis-affected communities." },
];

const approachSteps = [
  { title: "Identify needs", text: "Listen to communities and understand local priorities." },
  { title: "Design together", text: "Co-create practical, inclusive solutions with local partners." },
  { title: "Implement", text: "Deliver quality programmes with community ownership." },
  { title: "Monitor", text: "Track activities, collect evidence and measure progress." },
  { title: "Learn & adapt", text: "Use evidence and feedback to improve lasting impact." },
];
---

<BaseLayout title="Building Inclusive, Resilient Communities" description="GROWCHILD is a Nigerian women and youth-led humanitarian and development organization advancing inclusion, dignity and resilience.">
  <section class="home-hero">
    <div class="hero-media">
      <EditorialPhoto photo={photos.womenMarket} ratio="landscape" eager class="home-hero-photo" />
    </div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Inclusion · Dignity · Resilience</span>
        <h1>Building inclusive, resilient communities where everyone can thrive.</h1>
        <p>We work with women, children, persons with disabilities and vulnerable communities across Nigeria to strengthen wellbeing, protection and opportunity.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="/our-work/">Explore Our Programmes</a>
          <a class="button button-secondary" href="/partnerships/">Partner With Us</a>
        </div>
      </div>
    </div>
  </section>

  <section class="trust-strip" aria-label="GROWCHILD at a glance">
    <div class="container trust-grid">
      {trustPoints.map((item) => (
        <div class="trust-item"><strong>{item.value}</strong><span>{item.label}</span></div>
      ))}
    </div>
  </section>

  <section class="section intro-section">
    <div class="container intro-grid">
      <div><span class="eyebrow">Who we are</span><h2>Locally led. Community centred. Built around dignity.</h2></div>
      <div class="intro-copy">
        <p>GROWCHILD is a Nigerian women and youth-led humanitarian and development organization committed to improving the wellbeing, dignity, protection, inclusion and resilience of vulnerable populations.</p>
        <p>What began in 2017 as a grassroots response now brings community knowledge, evidence and accountable partnerships together.</p>
        <a class="text-link" href="/about/">Read our story <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section programmes-section">
    <div class="container">
      <div class="section-heading centered-heading">
        <span class="eyebrow">What we do</span>
        <h2>Six connected areas of action.</h2>
        <p>Our programmes respond to critical needs while strengthening long-term community resilience.</p>
      </div>
      <div class="focus-grid">
        {focusAreas.map((area, index) => (
          <a class="focus-card" href={`/our-work/#area-${index + 1}`} style={`--sdg-color:${area.color}`}>
            <div class="focus-card-top"><span class="sdg-label">{area.sdg}</span><span class="area-number" aria-hidden="true">0{index + 1}</span></div>
            <h3>{area.title}</h3>
            <p>{area.text}</p>
            <span class="focus-link">Learn more <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section approach-section">
    <div class="container">
      <div class="section-heading centered-heading">
        <span class="eyebrow">Our approach</span>
        <h2>Communities shape every step.</h2>
        <p>We combine local ownership with evidence, accountability and continuous learning.</p>
      </div>
      <ol class="approach-steps">
        {approachSteps.map((step, index) => (
          <li><span class="step-number">{index + 1}</span><h3>{step.title}</h3><p>{step.text}</p></li>
        ))}
      </ol>
      <a class="text-link approach-link" href="/our-approach/">Explore our approach <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="section commitments-section">
    <div class="container commitments-grid">
      <article class="regional-card">
        <EditorialPhoto photo={photos.ruralWomen} ratio="wide" class="regional-photo" />
        <div class="regional-copy">
          <span class="eyebrow">Where we work</span>
          <h2>Rooted in Nigeria's communities.</h2>
          <p>Our priority focus includes Borno, Adamawa and Yobe in the North-East, alongside the development of a wider regional network.</p>
          <a class="text-link" href="/where-we-work/">Explore our presence <span aria-hidden="true">→</span></a>
        </div>
      </article>
      <aside class="safeguarding-card">
        <span class="eyebrow">Our commitment</span>
        <h2>Safeguarding is non-negotiable.</h2>
        <p>We are committed to safe, respectful and inclusive programming for every person and community we work with.</p>
        <ul>
          <li>Child protection</li><li>Protection from sexual exploitation and abuse</li><li>Non-discrimination and inclusion</li><li>Confidential and accountable practice</li>
        </ul>
        <a class="button safeguarding-button" href="/safeguarding/">Read Our Commitments</a>
      </aside>
    </div>
  </section>

  <section class="partnership-banner">
    <div class="container banner-inner">
      <div>
        <span class="eyebrow">Work with us</span>
        <h2>Partner with us to build resilient communities.</h2>
        <p>Together, we can develop inclusive, accountable programmes shaped by the people they serve.</p>
      </div>
      <a class="button banner-button" href="/partnerships/">Become a Partner</a>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero { position: relative; min-height: clamp(38rem,72vw,47rem); overflow: hidden; background: #eef5ed; }
  .hero-media { position: absolute; inset: 0 0 0 42%; }
  :global(.home-hero-photo) { height: 100%; border-radius: 0; box-shadow: none; }
  :global(.home-hero-photo img) { object-position: center; }
  :global(.home-hero-photo figcaption) { inset: auto 1rem 1rem auto; }
  .home-hero::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg,#f7faf5 0%,#f7faf5 39%,rgba(247,250,245,.94) 48%,rgba(247,250,245,.18) 72%,rgba(247,250,245,0) 100%); pointer-events: none; }
  .hero-grid { position: relative; z-index: 1; min-height: inherit; align-items: center; display: grid; grid-template-columns: minmax(0,.92fr) minmax(0,1.08fr); }
  .hero-copy { display: grid; max-width: 43rem; justify-items: start; gap: 1.35rem; padding-block: 5rem; }
  .hero-copy h1 { max-width: 15ch; font-size: clamp(2.7rem,5.5vw,5.4rem); line-height: 1.02; }
  .hero-copy p { max-width: 38rem; color: var(--slate-grey); font-size: clamp(1.05rem,1.7vw,1.28rem); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .75rem; }

  .trust-strip { position: relative; z-index: 2; border-block: 1px solid var(--border); background: var(--white); box-shadow: 0 10px 34px rgba(10,72,35,.06); }
  .trust-grid { display: grid; grid-template-columns: repeat(4,1fr); }
  .trust-item { display: grid; gap: .2rem; padding: 1.55rem 1rem; text-align: center; }
  .trust-item + .trust-item { border-left: 1px solid var(--border); }
  .trust-item strong { color: var(--leaf-green); font-family: Poppins,Arial,sans-serif; font-size: clamp(1.4rem,2.5vw,2.05rem); line-height: 1.1; }
  .trust-item span { color: var(--slate-grey); font-size: .83rem; font-weight: 700; letter-spacing: .03em; text-transform: uppercase; }

  .intro-section { padding-block: clamp(4.5rem,9vw,8rem); }
  .intro-grid { display: grid; grid-template-columns: .92fr 1.08fr; gap: clamp(2rem,8vw,7rem); align-items: start; }
  .intro-grid h2, .section-heading h2 { margin-top: .9rem; }
  .intro-copy { display: grid; gap: 1.15rem; }
  .intro-copy p { color: var(--slate-grey); font-size: 1.08rem; }

  .programmes-section { background: #f7faf5; }
  .section-heading { max-width: 48rem; margin-bottom: 2.75rem; }
  .centered-heading { margin-inline: auto; text-align: center; }
  .centered-heading .eyebrow { justify-content: center; }
  .centered-heading p { margin-top: .9rem; color: var(--slate-grey); }
  .focus-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1rem; }
  .focus-card { position: relative; display: grid; min-height: 20rem; align-content: start; gap: 1rem; padding: 1.6rem; overflow: hidden; color: var(--slate-grey); border: 1px solid var(--border); border-top: 5px solid var(--sdg-color); border-radius: .75rem; background: var(--white); box-shadow: 0 8px 22px rgba(10,72,35,.04); text-decoration: none; transition: transform 220ms ease,box-shadow 220ms ease,border-color 220ms ease; }
  .focus-card::after { content: ""; position: absolute; right: -3rem; bottom: -4rem; width: 9rem; aspect-ratio: 1; border-radius: 50%; background: color-mix(in srgb,var(--sdg-color) 10%,transparent); transform: scale(.8); transition: transform 240ms ease; }
  .focus-card:hover, .focus-card:focus-visible { border-color: var(--sdg-color); box-shadow: 0 18px 38px color-mix(in srgb,var(--sdg-color) 18%,transparent); transform: translateY(-6px); }
  .focus-card:hover::after, .focus-card:focus-visible::after { transform: scale(1); }
  .focus-card > * { position: relative; z-index: 1; }
  .focus-card-top { display: flex; align-items: center; justify-content: space-between; color: var(--sdg-color); font-family: Poppins,Arial,sans-serif; font-weight: 700; }
  .sdg-label { display: inline-flex; padding: .35rem .55rem; border-radius: 999px; background: color-mix(in srgb,var(--sdg-color) 12%,white); font-size: .72rem; letter-spacing: .07em; }
  .area-number { opacity: .7; font-size: .9rem; letter-spacing: .1em; }
  .focus-card h3 { color: var(--deep-green); font-size: 1.1rem; }
  .focus-card p { font-size: .92rem; line-height: 1.65; }
  .focus-link { align-self: end; margin-top: auto; color: var(--sdg-color); font-family: Poppins,Arial,sans-serif; font-size: .88rem; font-weight: 700; }
  .focus-link span { display: inline-block; transition: transform 180ms ease; }
  .focus-card:hover .focus-link span, .focus-card:focus-visible .focus-link span { transform: translateX(.3rem); }

  .approach-section { overflow: hidden; }
  .approach-steps { position: relative; display: grid; grid-template-columns: repeat(5,1fr); gap: 1.2rem; margin: 0; padding: 0; list-style: none; }
  .approach-steps::before { content: ""; position: absolute; top: 2.05rem; right: 8%; left: 8%; height: 2px; background: #cfe1d0; }
  .approach-steps li { position: relative; z-index: 1; display: grid; justify-items: center; align-content: start; gap: .75rem; text-align: center; }
  .step-number { display: grid; width: 4.1rem; aspect-ratio: 1; place-items: center; color: var(--deep-green); border: 2px solid #b9d6b8; border-radius: 50%; background: var(--white); box-shadow: 0 0 0 .55rem var(--white); font-family: Poppins,Arial,sans-serif; font-size: 1.2rem; font-weight: 700; }
  .approach-steps h3 { font-size: 1rem; text-transform: capitalize; }
  .approach-steps p { color: var(--slate-grey); font-size: .86rem; line-height: 1.55; }
  .approach-link { width: fit-content; margin: 2.25rem auto 0; }

  .commitments-section { background: #f7faf5; }
  .commitments-grid { display: grid; grid-template-columns: 1.45fr .75fr; gap: 1.25rem; align-items: stretch; }
  .regional-card { display: grid; overflow: hidden; border: 1px solid var(--border); border-radius: 1rem; background: var(--white); box-shadow: var(--shadow-soft); }
  :global(.regional-photo) { border-radius: 0; box-shadow: none; }
  .regional-copy { display: grid; justify-items: start; gap: .9rem; padding: clamp(1.6rem,4vw,2.6rem); }
  .regional-copy h2, .safeguarding-card h2 { font-size: clamp(1.65rem,3vw,2.3rem); }
  .regional-copy p { max-width: 47rem; color: var(--slate-grey); }
  .safeguarding-card { display: grid; align-content: start; justify-items: start; gap: 1rem; padding: clamp(1.7rem,4vw,2.6rem); color: #34233f; border: 1px solid #e2d5ea; border-radius: 1rem; background: linear-gradient(145deg,#fbf8fd,#efe4f6); }
  .safeguarding-card .eyebrow, .safeguarding-card h2 { color: #5f267e; }
  .safeguarding-card .eyebrow::before { background: #7b329d; }
  .safeguarding-card p { color: #564b5c; }
  .safeguarding-card ul { display: grid; gap: .65rem; margin: .1rem 0 .5rem; padding-left: 1.2rem; }
  .safeguarding-button { color: var(--white); background: #6f2b90; }

  .partnership-banner { padding-block: clamp(4rem,8vw,6rem); color: var(--white); background: linear-gradient(120deg,var(--deep-green),#0d5e2b); }
  .banner-inner { display: flex; align-items: center; justify-content: space-between; gap: 2.5rem; }
  .banner-inner > div { display: grid; gap: .8rem; }
  .partnership-banner .eyebrow, .partnership-banner h2, .partnership-banner p { color: var(--white); }
  .partnership-banner .eyebrow::before { background: var(--white); }
  .partnership-banner h2 { max-width: 23ch; }
  .partnership-banner p { max-width: 46rem; opacity: .84; }
  .banner-button { flex: 0 0 auto; color: var(--deep-green); background: var(--white); }

  @media (max-width: 64rem) {
    .home-hero { min-height: auto; padding-top: 24rem; }
    .hero-media { inset: 0 0 auto; height: 27rem; }
    .home-hero::after { background: linear-gradient(0deg,#f7faf5 0%,#f7faf5 44%,rgba(247,250,245,.85) 60%,transparent 82%); }
    .hero-grid { display: block; }
    .hero-copy { max-width: 50rem; padding-block: 4rem; }
    .focus-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
    .approach-steps { grid-template-columns: repeat(3,1fr); row-gap: 2rem; }
    .approach-steps::before { display: none; }
    .commitments-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 46rem) {
    .home-hero { padding-top: 18rem; }
    .hero-media { height: 21rem; }
    .hero-copy { padding-block: 3.25rem; }
    .hero-copy h1 { font-size: clamp(2.35rem,12vw,3.4rem); }
    .trust-grid { grid-template-columns: repeat(2,1fr); }
    .trust-item:nth-child(3) { border-left: 0; border-top: 1px solid var(--border); }
    .trust-item:nth-child(4) { border-top: 1px solid var(--border); }
    .intro-grid, .focus-grid { grid-template-columns: 1fr; }
    .focus-card { min-height: 17rem; }
    .approach-steps { grid-template-columns: 1fr; gap: 1.6rem; }
    .approach-steps li { grid-template-columns: auto 1fr; justify-items: start; column-gap: 1rem; text-align: left; }
    .approach-steps h3 { align-self: center; }
    .approach-steps p { grid-column: 2; }
    .step-number { grid-row: 1 / 3; width: 3.3rem; box-shadow: none; }
    .banner-inner { align-items: flex-start; flex-direction: column; }
  }
  @media (prefers-reduced-motion: reduce) { .focus-card:hover, .focus-card:focus-visible, .focus-card:hover::after, .focus-card:focus-visible::after { transform: none; } }
</style>
