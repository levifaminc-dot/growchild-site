---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Page Not Found" description="The requested GROWCHILD page could not be found." robots="noindex, follow">
  <section class="missing"><div class="container"><span class="eyebrow">Page not found</span><h1>We couldn't find that page.</h1><p>The page may have moved or the address may be incomplete.</p><div class="missing-actions"><a class="button button-primary" href="/">Return home</a><a class="button button-secondary" href="/our-work/">Explore our work</a><a class="text-link" href="/contact/">Contact GROWCHILD</a></div></div></section>
</BaseLayout>
<style>
  .missing { min-height: 60vh; display: grid; place-items: center; padding-block: 5rem; text-align: center; }
  .missing .container { display: grid; justify-items: center; gap: 1.25rem; }
  .missing p { max-width: 34rem; }
  .missing-actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: .75rem; }
</style>
