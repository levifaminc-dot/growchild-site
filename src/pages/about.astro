---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import AboutSubnav from "../components/AboutSubnav.astro";
import EditorialPhoto from "../components/EditorialPhoto.astro";
import { photos } from "../data/photos";

const values = ["Inclusion", "Dignity", "Resilience", "Accountability", "Evidence & Learning"];

const facts = [
  { value: "2017", label: "Grassroots beginnings" },
  { value: "2026", label: "CAC registration" },
  { value: "6", label: "Programme areas" },
  { value: "18", label: "States of operation" },
];

const strengths = [
  { number: "01", title: "Community-led", text: "We work with communities as partners in defining priorities and shaping practical solutions.", color: "#622B86" },
  { number: "02", title: "Evidence-driven", text: "Data, monitoring and learning guide decisions throughout the programme lifecycle.", color: "#2C6510" },
  { number: "03", title: "Inclusive programmes", text: "Women, children, persons with disabilities and underserved groups are intentionally included.", color: "#00609D" },
  { number: "04", title: "Women & youth-led", text: "Inclusive leadership and local knowledge strengthen ownership and long-term resilience.", color: "#9A3C06" },
  { number: "05", title: "Accountable & safe", text: "Safeguarding, transparency and responsible practice are embedded in our work.", color: "#DD1367" },
];

---

<BaseLayout title="About Us" description="Learn about GROWCHILD's journey, mission, values, institutional commitments and governance.">
  <PageHero
    title="About GROWCHILD"
    intro="A Nigerian women and youth-led organization advancing inclusion, dignity and resilience with communities."
    parent="About Us"
    photo={photos.womenYouthTownhall}
    primaryHref="#mission-vision"
    primaryLabel="Our Mission & Vision"
  />
  <AboutSubnav />

  <section class="section summary-section" id="mission-vision">
    <div class="container">
      <header class="summary-heading">
        <span class="eyebrow">Purpose &amp; principles</span>
        <h2>The commitments behind every programme and partnership.</h2>
        <p>Our mission, vision, values and promise keep GROWCHILD focused on work that is inclusive, accountable and shaped with communities.</p>
      </header>
      <div class="summary-grid">
        <article class="summary-card summary-card--mission">
          <div class="summary-card-top"><span class="summary-number" aria-hidden="true">01</span><span class="summary-kicker">What we do</span></div>
          <div><h3>Our Mission</h3><p>To strengthen the capacity and resilience of vulnerable communities through inclusive humanitarian and development interventions that promote protection, empowerment, access to services, evidence-based programming and locally led solutions.</p></div>
        </article>
        <article class="summary-card summary-card--vision">
          <div class="summary-card-top"><span class="summary-number" aria-hidden="true">02</span><span class="summary-kicker">The future we seek</span></div>
          <div><h3>Our Vision</h3><p>A Nigeria where women, children, persons with disabilities and vulnerable communities live with dignity, resilience, equal opportunities and the ability to participate in decisions affecting their lives.</p></div>
        </article>
        <article class="summary-card summary-card--values">
          <div class="summary-card-top"><span class="summary-number" aria-hidden="true">03</span><span class="summary-kicker">How we show up</span></div>
          <div><h3>Our Values</h3><ul>{values.map((value) => <li>{value}</li>)}</ul></div>
        </article>
        <article class="summary-card summary-card--promise">
          <div class="summary-card-top"><span class="summary-number" aria-hidden="true">04</span><span class="summary-kicker">Our commitment</span></div>
          <div><h3>Our Promise</h3><p>We are committed to safe, transparent, accountable and people-centred programming that respects every person's rights, voice and dignity.</p></div>
        </article>
      </div>
    </div>
  </section>

  <section class="section story-section">
    <div class="container story-grid">
      <EditorialPhoto photo={photos.communityOutreach} ratio="portrait" class="story-photo" />
      <div class="story-copy">
        <span class="eyebrow">Our story</span>
        <h2>From grassroots response to accountable action.</h2>
        <p>GROWCHILD was conceptualized in 2017 in response to the growing challenges affecting women, children and vulnerable households in crisis-affected and underserved communities, particularly in Northern Nigeria.</p>
        <p>The organization brings community knowledge, inclusive leadership and evidence together to improve access to essential services, strengthen resilience and support locally led solutions.</p>
        <p>GROWCHILD was formally registered with the Corporate Affairs Commission, Nigeria, in 2026 under Registration Number RC 9704884.</p>
        <a class="text-link" href="/our-approach/">Learn how we work <span aria-hidden="true">→</span></a>
      </div>
      <aside class="facts-panel" aria-label="GROWCHILD at a glance">
        {facts.map((fact) => <div><strong>{fact.value}</strong><span>{fact.label}</span></div>)}
      </aside>
    </div>
  </section>

  <section class="section strengths-section">
    <div class="container">
      <div class="section-heading"><span class="eyebrow">Why GROWCHILD</span><h2>Principles that shape our work.</h2><p>Our programmes are designed around partnership, inclusion, evidence and responsible practice.</p></div>
      <div class="strengths-grid">
        {strengths.map((strength) => (
          <article style={`--strength-color:${strength.color}`}>
            <span>{strength.number}</span><h3>{strength.title}</h3><p>{strength.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="impact-banner">
    <div class="container impact-inner">
      <div><span class="eyebrow">Work with us</span><h2>Together, we can strengthen inclusive and resilient communities.</h2><p>Partner with GROWCHILD on locally led, evidence-based programmes across Nigeria.</p></div>
      <a class="button" href="/partnerships/">Explore Partnerships</a>
    </div>
  </section>

  <section class="section leadership">
    <div class="container">
      <header class="leadership-heading">
        <span class="eyebrow">Leadership & accountability</span>
        <h2>Our Governance</h2>
        <p>Approved leadership information will be published after the organisation completes its governance review.</p>
      </header>
      <div class="leadership-pending" role="note">
        <span aria-hidden="true">✓</span>
        <div><h3>Governance information under review</h3><p>Names, positions, photographs and biographies will appear here only after they have been approved for public release.</p></div>
      </div>
      <div class="registration">
        <div class="registration-copy">
          <span class="registration-badge" aria-label="CAC registered, registration number RC 9704884"><span class="verification-mark" aria-hidden="true">✓</span><span><strong>CAC Registered</strong><small>Registration No. RC 9704884</small></span></span>
          <p>Registered with the Corporate Affairs Commission, Nigeria.</p>
        </div>
        <a href="/safeguarding/">Read our safeguarding commitment <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .summary-section { position: relative; overflow: hidden; background: linear-gradient(145deg,#f8fbf6 0%,#eef6ef 58%,#f5f1f8 100%); }
  .summary-section::before { content: ""; position: absolute; inset: -13rem -10rem auto auto; width: 28rem; aspect-ratio: 1; border-radius: 50%; background: rgba(83,152,25,.09); }
  .summary-heading { position: relative; z-index: 1; display: grid; max-width: 58rem; gap: 1rem; margin-bottom: clamp(2.25rem,5vw,3.5rem); }
  .summary-heading h2 { max-width: 19ch; font-size: clamp(2.45rem,5.3vw,4rem); }
  .summary-heading p { max-width: 48rem; color: #526058; font-size: clamp(1.05rem,1.8vw,1.22rem); }
  .summary-grid { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(12,minmax(0,1fr)); gap: 1.25rem; }
  .summary-card { position: relative; display: grid; align-content: space-between; gap: clamp(2.5rem,5vw,4.75rem); min-height: 22rem; padding: clamp(1.75rem,3vw,2.5rem); overflow: hidden; border: 1px solid rgba(10,72,35,.13); border-radius: 1.25rem; background: var(--white); box-shadow: 0 18px 46px rgba(10,72,35,.08); transition: transform 200ms ease, box-shadow 200ms ease; }
  .summary-card:hover { transform: translateY(-5px); box-shadow: 0 24px 54px rgba(10,72,35,.13); }
  .summary-card::after { content: ""; position: absolute; inset: auto -4rem -5rem auto; width: 14rem; aspect-ratio: 1; border-radius: 50%; background: var(--card-orb,rgba(83,152,25,.08)); }
  .summary-card-top { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .summary-number { display: grid; width: 3.1rem; aspect-ratio: 1; place-items: center; color: var(--card-accent,var(--leaf-green-dark)); border: 1px solid currentColor; border-radius: 50%; font: 700 .82rem Poppins,Arial,sans-serif; letter-spacing: .08em; }
  .summary-kicker { color: var(--card-accent,var(--leaf-green-dark)); font: 700 .76rem Poppins,Arial,sans-serif; letter-spacing: .12em; text-transform: uppercase; }
  .summary-card > div:last-child { position: relative; z-index: 1; }
  .summary-card h3 { max-width: 15ch; font-size: clamp(2rem,3.7vw,3rem); }
  .summary-card p, .summary-card ul { margin-top: 1rem; color: #4d5a52; font-size: clamp(1rem,1.45vw,1.12rem); line-height: 1.62; }
  .summary-card--mission { grid-column: span 7; --card-accent: var(--leaf-green-dark); --card-orb: rgba(83,152,25,.11); }
  .summary-card--vision { grid-column: span 5; --card-accent: var(--deep-blue); --card-orb: rgba(0,96,157,.1); background: linear-gradient(145deg,#fff,#f0f8fc); }
  .summary-card--values { grid-column: span 7; min-height: 18rem; color: var(--white); --card-accent: #c7eea8; --card-orb: rgba(255,255,255,.08); background: linear-gradient(135deg,#073918,var(--deep-green)); }
  .summary-card--values h3, .summary-card--values .summary-kicker { color: var(--white); }
  .summary-card--values .summary-number { color: var(--white); border-color: rgba(255,255,255,.55); }
  .summary-card ul { display: flex; flex-wrap: wrap; gap: .65rem; margin-bottom: 0; padding: 0; list-style: none; }
  .summary-card li { padding: .55rem .85rem; color: var(--white); border: 1px solid rgba(255,255,255,.25); border-radius: 999px; background: rgba(255,255,255,.1); font-weight: 700; line-height: 1.25; }
  .summary-card--promise { grid-column: span 5; min-height: 18rem; color: var(--white); --card-accent: #ead7f5; --card-orb: rgba(255,255,255,.09); border-color: rgba(98,43,134,.25); background: linear-gradient(135deg,#4c1d69,var(--royal-purple)); }
  .summary-card--promise h3, .summary-card--promise p, .summary-card--promise .summary-kicker { color: var(--white); }
  .summary-card--promise p { color: rgba(255,255,255,.9); }
  .summary-card--promise .summary-number { color: var(--white); border-color: rgba(255,255,255,.55); }

  .story-grid { display: grid; grid-template-columns: .82fr 1fr .62fr; gap: clamp(1.5rem,4vw,3rem); align-items: center; }
  :global(.story-photo) { min-height: 32rem; }
  .story-copy { display: grid; justify-items: start; gap: 1rem; }
  .story-copy h2 { margin-bottom: .25rem; }
  .story-copy p { color: var(--slate-grey); }
  .facts-panel { overflow: hidden; border: 1px solid var(--border); border-radius: .85rem; background: var(--white); box-shadow: var(--shadow-soft); }
  .facts-panel div { display: grid; gap: .15rem; padding: 1.15rem 1.3rem; }
  .facts-panel div + div { border-top: 1px solid var(--border); }
  .facts-panel strong { color: var(--leaf-green-dark); font: 700 1.6rem Poppins,Arial,sans-serif; }
  .facts-panel span { color: var(--slate-grey); font-size: .875rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }

  .strengths-section { background: #f7faf5; }
  .section-heading { max-width: 48rem; margin-bottom: 2.7rem; }
  .section-heading h2 { margin-top: .8rem; }
  .section-heading p { margin-top: .8rem; color: var(--slate-grey); }
  .strengths-grid { display: grid; grid-template-columns: repeat(5,1fr); gap: 0; }
  .strengths-grid article { padding: 1.4rem; border-left: 1px solid var(--border); }
  .strengths-grid article:first-child { border-left: 0; }
  .strengths-grid article > span { display: grid; width: 3.25rem; aspect-ratio: 1; place-items: center; margin-bottom: 1.2rem; color: var(--white); border-radius: 50%; background: var(--strength-color); font: 700 .78rem Poppins,Arial,sans-serif; }
  .strengths-grid h3 { font-size: 1rem; }
  .strengths-grid p { margin-top: .65rem; color: var(--slate-grey); font-size: .9rem; line-height: 1.55; }

  .impact-banner { padding-block: clamp(3.5rem,7vw,5rem); color: var(--white); background: linear-gradient(100deg,var(--deep-green),#0f6a31); }
  .impact-inner { display: flex; align-items: center; justify-content: space-between; gap: 2.5rem; }
  .impact-inner > div { display: grid; gap: .7rem; }
  .impact-banner .eyebrow, .impact-banner h2, .impact-banner p { color: var(--white); }
  .impact-banner .eyebrow::before { background: var(--white); }
  .impact-banner h2 { max-width: 26ch; font-size: clamp(1.8rem,3.5vw,2.7rem); }
  .impact-banner p { max-width: 48rem; opacity: .86; }
  .impact-banner .button { flex: 0 0 auto; color: var(--deep-green); background: var(--white); }

  .leadership { background: #fbfcfb; }
  .leadership-heading { max-width: 42rem; margin-inline: auto; text-align: center; }
  .leadership-heading .eyebrow { justify-content: center; }
  .leadership-heading h2 { margin-top: .8rem; color: #171b18; font-size: clamp(2rem,4vw,3rem); font-weight: 500; letter-spacing: -.03em; }
  .leadership-heading p { max-width: 36rem; margin: 1rem auto 0; color: #59625c; }
  .leadership-pending { display: grid; grid-template-columns: auto 1fr; max-width: 48rem; gap: 1rem; margin: 2.5rem auto 0; padding: clamp(1.4rem,4vw,2rem); border: 2px dashed #b8c9b8; border-radius: .75rem; background: var(--white); }
  .leadership-pending > span { display: grid; width: 2.6rem; aspect-ratio: 1; place-items: center; color: var(--white); border-radius: 50%; background: var(--leaf-green-dark); font-weight: 700; }
  .leadership-pending h3 { font-size: 1.1rem; }
  .leadership-pending p { margin-top: .45rem; }
  .registration { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; margin-top: 2rem; padding: 1.25rem 1.4rem; border-radius: .75rem; color: var(--white); background: var(--deep-green); }
  .registration-copy { display: flex; align-items: center; gap: 1.25rem; }
  .registration-copy > p { color: rgba(255,255,255,.86); font-size: .92rem; }
  .registration-badge { display: inline-flex; flex: 0 0 auto; align-items: center; gap: .65rem; padding: .65rem .8rem; color: var(--deep-green); border: 1px solid rgba(255,255,255,.65); border-radius: .55rem; background: var(--white); box-shadow: 0 7px 18px rgba(0,0,0,.14); }
  .registration-badge > span:last-child { display: grid; line-height: 1.2; }
  .registration-badge strong { font: 700 .78rem Poppins,Arial,sans-serif; letter-spacing: .04em; text-transform: uppercase; }
  .registration-badge small { margin-top: .18rem; color: var(--slate-grey); font-size: .78rem; }
  .verification-mark { display: grid; width: 2rem; aspect-ratio: 1; place-items: center; color: var(--white); border-radius: 50%; background: var(--leaf-green-dark); font-weight: 700; }
  .registration a { flex: 0 0 auto; font-weight: 700; text-underline-offset: .25rem; }

  @media (max-width: 64rem) { .summary-card--mission, .summary-card--vision, .summary-card--values, .summary-card--promise { grid-column: span 6; } .story-grid { grid-template-columns: .85fr 1.15fr; } .facts-panel { grid-column: 1/-1; display: grid; grid-template-columns: repeat(4,1fr); } .facts-panel div + div { border-top: 0; border-left: 1px solid var(--border); } .strengths-grid { grid-template-columns: repeat(3,1fr); gap: 1rem; } .strengths-grid article { border: 1px solid var(--border); border-radius: .7rem; background: var(--white); } }
  @media (max-width: 48rem) { .story-grid { grid-template-columns: 1fr; } :global(.story-photo) { min-height: 24rem; } .facts-panel { grid-template-columns: repeat(2,1fr); } .facts-panel div:nth-child(3) { border-left: 0; border-top: 1px solid var(--border); } .facts-panel div:nth-child(4) { border-top: 1px solid var(--border); } .strengths-grid { grid-template-columns: 1fr 1fr; } .impact-inner, .registration { align-items: flex-start; flex-direction: column; } }
  @media (max-width: 38rem) { .summary-grid { grid-template-columns: 1fr; } .summary-card--mission, .summary-card--vision, .summary-card--values, .summary-card--promise { grid-column: 1; } .strengths-grid { grid-template-columns: 1fr; } .summary-card { min-height: auto; gap: 2.75rem; } .summary-heading h2 { font-size: clamp(2.25rem,11vw,3rem); } }
  @media (max-width: 34rem) { .leadership-pending { grid-template-columns: 1fr; } .registration-copy { align-items: flex-start; flex-direction: column; } }
</style>
