---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import AboutSubnav from "../components/AboutSubnav.astro";
import EditorialPhoto from "../components/EditorialPhoto.astro";
import { photos } from "../data/photos";

const values = ["Inclusion", "Dignity", "Resilience", "Accountability", "Evidence & Learning"];

const facts = [
  { value: "2017", label: "Grassroots beginnings" },
  { value: "2026", label: "CAC registration" },
  { value: "6", label: "Programme areas" },
  { value: "15", label: "States of operation" },
];

const strengths = [
  { number: "01", title: "Community-led", text: "We work with communities as partners in defining priorities and shaping practical solutions.", color: "#622B86" },
  { number: "02", title: "Evidence-driven", text: "Data, monitoring and learning guide decisions throughout the programme lifecycle.", color: "#2C6510" },
  { number: "03", title: "Inclusive programmes", text: "Women, children, persons with disabilities and underserved groups are intentionally included.", color: "#00609D" },
  { number: "04", title: "Women & youth-led", text: "Inclusive leadership and local knowledge strengthen ownership and long-term resilience.", color: "#E56A18" },
  { number: "05", title: "Accountable & safe", text: "Safeguarding, transparency and responsible practice are embedded in our work.", color: "#DD1367" },
];

interface GovernanceProfile {
  id: string;
  name: string;
  position: string;
  biography: string;
  image?: string;
}

const governanceProfiles: GovernanceProfile[] = [
  { id: "governance-profile-1", name: "Name to be confirmed", position: "Position to be confirmed", biography: "The approved professional biography for this governance member will be added here." },
  { id: "governance-profile-2", name: "Name to be confirmed", position: "Position to be confirmed", biography: "The approved professional biography for this governance member will be added here." },
  { id: "governance-profile-3", name: "Name to be confirmed", position: "Position to be confirmed", biography: "The approved professional biography for this governance member will be added here." },
];
---

<BaseLayout title="About Us" description="Learn about GROWCHILD's journey, mission, values, institutional commitments and governance.">
  <PageHero
    title="About GROWCHILD"
    intro="A Nigerian women and youth-led organization advancing inclusion, dignity and resilience with communities."
    parent="About Us"
    photo={photos.womenYouthTownhall}
    primaryHref="#mission-vision"
    primaryLabel="Our Mission & Vision"
  />
  <AboutSubnav />

  <section class="section summary-section" id="mission-vision">
    <div class="container summary-grid">
      <article class="summary-card">
        <span class="summary-number">01</span>
        <h2>Our Mission</h2>
        <p>To strengthen the capacity and resilience of vulnerable communities through inclusive humanitarian and development interventions that promote protection, empowerment, access to services, evidence-based programming and locally led solutions.</p>
      </article>
      <article class="summary-card">
        <span class="summary-number">02</span>
        <h2>Our Vision</h2>
        <p>A Nigeria where women, children, persons with disabilities and vulnerable communities live with dignity, resilience, equal opportunities and the ability to participate in decisions affecting their lives.</p>
      </article>
      <article class="summary-card">
        <span class="summary-number">03</span>
        <h2>Our Values</h2>
        <ul>{values.map((value) => <li>{value}</li>)}</ul>
      </article>
      <article class="summary-card promise-card">
        <span class="summary-number">04</span>
        <h2>Our Promise</h2>
        <p>We are committed to safe, transparent, accountable and people-centred programming that respects every person's rights, voice and dignity.</p>
      </article>
    </div>
  </section>

  <section class="section story-section">
    <div class="container story-grid">
      <EditorialPhoto photo={photos.communityOutreach} ratio="portrait" class="story-photo" />
      <div class="story-copy">
        <span class="eyebrow">Our story</span>
        <h2>From grassroots response to accountable action.</h2>
        <p>GROWCHILD was conceptualized in 2017 in response to the growing challenges affecting women, children and vulnerable households in crisis-affected and underserved communities, particularly in Northern Nigeria.</p>
        <p>The organization brings community knowledge, inclusive leadership and evidence together to improve access to essential services, strengthen resilience and support locally led solutions.</p>
        <p>GROWCHILD was formally registered with the Corporate Affairs Commission, Nigeria, in 2026 under Registration Number RC 9704884.</p>
        <a class="text-link" href="/our-approach/">Learn how we work <span aria-hidden="true">→</span></a>
      </div>
      <aside class="facts-panel" aria-label="GROWCHILD at a glance">
        {facts.map((fact) => <div><strong>{fact.value}</strong><span>{fact.label}</span></div>)}
      </aside>
    </div>
  </section>

  <section class="section strengths-section">
    <div class="container">
      <div class="section-heading"><span class="eyebrow">Why GROWCHILD</span><h2>Principles that shape our work.</h2><p>Our programmes are designed around partnership, inclusion, evidence and responsible practice.</p></div>
      <div class="strengths-grid">
        {strengths.map((strength) => (
          <article style={`--strength-color:${strength.color}`}>
            <span>{strength.number}</span><h3>{strength.title}</h3><p>{strength.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="impact-banner">
    <div class="container impact-inner">
      <div><span class="eyebrow">Work with us</span><h2>Together, we can strengthen inclusive and resilient communities.</h2><p>Partner with GROWCHILD on locally led, evidence-based programmes across Nigeria.</p></div>
      <a class="button" href="/partnerships/">Explore Partnerships</a>
    </div>
  </section>

  <section class="section leadership">
    <div class="container">
      <header class="leadership-heading">
        <span class="eyebrow">Leadership & accountability</span>
        <h2>Our Governance</h2>
        <p>Governance profiles will introduce the people responsible for organizational oversight and accountability.</p>
      </header>
      <div class="leadership-grid">
        {governanceProfiles.map((profile) => (
          <article class="governance-profile">
            <button class="profile-card" type="button" data-biography-target={profile.id} aria-haspopup="dialog" aria-controls={profile.id}>
              <span class="profile-photo-frame">
                {profile.image ? <img src={profile.image} alt={`Portrait of ${profile.name}`} loading="lazy" /> : <span class="profile-photo-slot" role="img" aria-label={`Portrait photograph for ${profile.name} to be added`}><span>Portrait photograph</span><small>To be added</small></span>}
              </span>
              <span class="profile-copy"><strong>{profile.name}</strong><span>{profile.position}</span></span>
              <span class="sr-only">View biography</span>
            </button>
            <dialog id={profile.id} aria-labelledby={`${profile.id}-title`}>
              <div class="biography-dialog">
                <form method="dialog"><button class="dialog-close" type="submit" aria-label="Close biography">×</button></form>
                <span class="profile-label">Governance profile</span>
                <h3 id={`${profile.id}-title`}>{profile.name}</h3>
                <p class="dialog-position">{profile.position}</p>
                <p>{profile.biography}</p>
              </div>
            </dialog>
          </article>
        ))}
      </div>
      <div class="registration">
        <div class="registration-copy">
          <span class="registration-badge" aria-label="CAC registered, registration number RC 9704884"><span class="verification-mark" aria-hidden="true">✓</span><span><strong>CAC Registered</strong><small>Registration No. RC 9704884</small></span></span>
          <p>Registered with the Corporate Affairs Commission, Nigeria.</p>
        </div>
        <a href="/safeguarding/">Read our safeguarding commitment <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <script>
    document.querySelectorAll<HTMLButtonElement>("[data-biography-target]").forEach((button) => {
      button.addEventListener("click", () => {
        const dialog = document.getElementById(button.dataset.biographyTarget || "");
        if (dialog instanceof HTMLDialogElement) dialog.showModal();
      });
    });
  </script>
</BaseLayout>

<style>
  .summary-section { background: #f7faf5; }
  .summary-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 1rem; }
  .summary-card { position: relative; display: grid; align-content: start; gap: .9rem; min-height: 22rem; padding: 1.6rem; overflow: hidden; border: 1px solid var(--border); border-radius: .85rem; background: var(--white); box-shadow: 0 8px 24px rgba(10,72,35,.05); }
  .summary-card::after { content: ""; position: absolute; inset: auto -2.5rem -3rem auto; width: 8rem; aspect-ratio: 1; border-radius: 50%; background: rgba(83,152,25,.08); }
  .summary-number { position: relative; z-index: 1; width: fit-content; padding: .25rem .55rem; color: var(--leaf-green-dark); border-radius: 999px; background: #eff7e9; font: 700 .78rem Poppins,Arial,sans-serif; letter-spacing: .08em; }
  .summary-card h2 { position: relative; z-index: 1; font-size: 1.35rem; }
  .summary-card p, .summary-card ul { position: relative; z-index: 1; color: var(--slate-grey); font-size: .96rem; }
  .summary-card ul { display: grid; gap: .35rem; margin: 0; padding: 0; list-style: none; }
  .summary-card li { position: relative; padding-left: 1.35rem; }
  .summary-card li::before { content: "✓"; position: absolute; left: 0; color: var(--leaf-green-dark); font-weight: 700; }
  .promise-card { border-top: 4px solid var(--royal-purple); }

  .story-grid { display: grid; grid-template-columns: .82fr 1fr .62fr; gap: clamp(1.5rem,4vw,3rem); align-items: center; }
  :global(.story-photo) { min-height: 32rem; }
  .story-copy { display: grid; justify-items: start; gap: 1rem; }
  .story-copy h2 { margin-bottom: .25rem; }
  .story-copy p { color: var(--slate-grey); }
  .facts-panel { overflow: hidden; border: 1px solid var(--border); border-radius: .85rem; background: var(--white); box-shadow: var(--shadow-soft); }
  .facts-panel div { display: grid; gap: .15rem; padding: 1.15rem 1.3rem; }
  .facts-panel div + div { border-top: 1px solid var(--border); }
  .facts-panel strong { color: var(--leaf-green-dark); font: 700 1.6rem Poppins,Arial,sans-serif; }
  .facts-panel span { color: var(--slate-grey); font-size: .85rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }

  .strengths-section { background: #f7faf5; }
  .section-heading { max-width: 48rem; margin-bottom: 2.7rem; }
  .section-heading h2 { margin-top: .8rem; }
  .section-heading p { margin-top: .8rem; color: var(--slate-grey); }
  .strengths-grid { display: grid; grid-template-columns: repeat(5,1fr); gap: 0; }
  .strengths-grid article { padding: 1.4rem; border-left: 1px solid var(--border); }
  .strengths-grid article:first-child { border-left: 0; }
  .strengths-grid article > span { display: grid; width: 3.25rem; aspect-ratio: 1; place-items: center; margin-bottom: 1.2rem; color: var(--white); border-radius: 50%; background: var(--strength-color); font: 700 .78rem Poppins,Arial,sans-serif; }
  .strengths-grid h3 { font-size: 1rem; }
  .strengths-grid p { margin-top: .65rem; color: var(--slate-grey); font-size: .9rem; line-height: 1.55; }

  .impact-banner { padding-block: clamp(3.5rem,7vw,5rem); color: var(--white); background: linear-gradient(100deg,var(--deep-green),#0f6a31); }
  .impact-inner { display: flex; align-items: center; justify-content: space-between; gap: 2.5rem; }
  .impact-inner > div { display: grid; gap: .7rem; }
  .impact-banner .eyebrow, .impact-banner h2, .impact-banner p { color: var(--white); }
  .impact-banner .eyebrow::before { background: var(--white); }
  .impact-banner h2 { max-width: 26ch; font-size: clamp(1.8rem,3.5vw,2.7rem); }
  .impact-banner p { max-width: 48rem; opacity: .86; }
  .impact-banner .button { flex: 0 0 auto; color: var(--deep-green); background: var(--white); }

  .leadership { background: #fbfcfb; }
  .leadership-heading { max-width: 42rem; margin-inline: auto; text-align: center; }
  .leadership-heading .eyebrow { justify-content: center; }
  .leadership-heading h2 { margin-top: .8rem; color: #171b18; font-size: clamp(2rem,4vw,3rem); font-weight: 500; letter-spacing: -.03em; }
  .leadership-heading p { max-width: 36rem; margin: 1rem auto 0; color: #59625c; }
  .leadership-grid { display: grid; grid-template-columns: repeat(3,minmax(0,15rem)); justify-content: center; gap: clamp(1rem,3vw,2rem); margin-top: 3rem; }
  .governance-profile { min-width: 0; }
  .profile-card { display: grid; width: 100%; min-height: 100%; padding: 0; overflow: hidden; color: var(--slate-grey); text-align: left; border: 0; border-bottom: 3px solid var(--deep-blue); border-radius: .3rem; background: var(--white); box-shadow: 0 8px 26px rgba(15,38,25,.08); cursor: pointer; font: inherit; transition: box-shadow 200ms ease,transform 200ms ease; }
  .profile-card:hover, .profile-card:focus-visible { box-shadow: 0 18px 38px rgba(15,38,25,.15); transform: translateY(-5px); }
  .profile-photo-frame { display: block; aspect-ratio: 4 / 4.25; overflow: hidden; background: linear-gradient(180deg,#fff 0%,#eef1ef 100%); }
  .profile-photo-frame > img { width: 100%; height: 100%; object-fit: cover; object-position: center top; }
  .profile-photo-slot { display: grid; width: 100%; height: 100%; place-content: center; gap: .2rem; color: #69736c; text-align: center; background: linear-gradient(180deg,#fff,#e7ebe8); }
  .profile-photo-slot span { font: 600 .78rem Poppins,Arial,sans-serif; letter-spacing: .05em; text-transform: uppercase; }
  .profile-photo-slot small { font-size: .75rem; }
  .profile-copy { display: grid; align-content: start; gap: .25rem; padding: 1rem 1rem 1.1rem; }
  .profile-copy strong { color: #171b18; font-family: Poppins,Arial,sans-serif; font-size: 1rem; font-weight: 600; }
  .profile-copy > span { color: #68716b; font-size: .82rem; }
  .profile-label { color: var(--royal-purple); font: 700 .75rem Poppins,Arial,sans-serif; letter-spacing: .1em; text-transform: uppercase; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  dialog { position: fixed; inset: 50% auto auto 50%; width: min(34rem,calc(100% - 2rem)); max-height: calc(100dvh - 2rem); margin: 0; padding: 0; overflow-y: auto; color: var(--slate-grey); border: 0; border-radius: 1rem; box-shadow: 0 1.5rem 5rem rgba(0,0,0,.28); transform: translate(-50%,-50%); }
  dialog::backdrop { background: rgba(3,28,13,.72); backdrop-filter: blur(4px); }
  .biography-dialog { position: relative; display: grid; gap: .75rem; padding: clamp(1.75rem,5vw,3rem); }
  .biography-dialog h3 { padding-right: 2.5rem; font-size: clamp(1.4rem,3vw,2rem); }
  .biography-dialog > p:last-child { margin-top: .5rem; }
  .dialog-position { color: var(--leaf-green-dark); font-family: Poppins,Arial,sans-serif; font-weight: 700; }
  .dialog-close { position: absolute; inset: 1rem 1rem auto auto; display: grid; width: 2.5rem; aspect-ratio: 1; place-items: center; color: var(--deep-green); border: 1px solid var(--border); border-radius: 50%; background: var(--surface-tint); cursor: pointer; font-size: 1.5rem; line-height: 1; }
  .dialog-close:hover, .dialog-close:focus-visible { color: var(--white); border-color: var(--deep-green); background: var(--deep-green); }
  .registration { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; margin-top: 2rem; padding: 1.25rem 1.4rem; border-radius: .75rem; color: var(--white); background: var(--deep-green); }
  .registration-copy { display: flex; align-items: center; gap: 1.25rem; }
  .registration-copy > p { color: rgba(255,255,255,.86); font-size: .92rem; }
  .registration-badge { display: inline-flex; flex: 0 0 auto; align-items: center; gap: .65rem; padding: .65rem .8rem; color: var(--deep-green); border: 1px solid rgba(255,255,255,.65); border-radius: .55rem; background: var(--white); box-shadow: 0 7px 18px rgba(0,0,0,.14); }
  .registration-badge > span:last-child { display: grid; line-height: 1.2; }
  .registration-badge strong { font: 700 .78rem Poppins,Arial,sans-serif; letter-spacing: .04em; text-transform: uppercase; }
  .registration-badge small { margin-top: .18rem; color: var(--slate-grey); font-size: .72rem; }
  .verification-mark { display: grid; width: 2rem; aspect-ratio: 1; place-items: center; color: var(--white); border-radius: 50%; background: var(--leaf-green-dark); font-weight: 700; }
  .registration a { flex: 0 0 auto; font-weight: 700; text-underline-offset: .25rem; }

  @media (max-width: 64rem) { .summary-grid { grid-template-columns: repeat(2,1fr); } .story-grid { grid-template-columns: .85fr 1.15fr; } .facts-panel { grid-column: 1/-1; display: grid; grid-template-columns: repeat(4,1fr); } .facts-panel div + div { border-top: 0; border-left: 1px solid var(--border); } .strengths-grid { grid-template-columns: repeat(3,1fr); gap: 1rem; } .strengths-grid article { border: 1px solid var(--border); border-radius: .7rem; background: var(--white); } }
  @media (max-width: 48rem) { .story-grid { grid-template-columns: 1fr; } :global(.story-photo) { min-height: 24rem; } .facts-panel { grid-template-columns: repeat(2,1fr); } .facts-panel div:nth-child(3) { border-left: 0; border-top: 1px solid var(--border); } .facts-panel div:nth-child(4) { border-top: 1px solid var(--border); } .strengths-grid { grid-template-columns: 1fr 1fr; } .impact-inner, .registration { align-items: flex-start; flex-direction: column; } .leadership-grid { grid-template-columns: repeat(2,minmax(0,15rem)); } }
  @media (max-width: 38rem) { .summary-grid, .strengths-grid { grid-template-columns: 1fr; } .summary-card { min-height: auto; } }
  @media (max-width: 34rem) { .leadership-grid { grid-template-columns: minmax(0,18rem); } .registration-copy { align-items: flex-start; flex-direction: column; } dialog { width: calc(100% - 1rem); max-height: calc(100dvh - 1rem); } }
  @media (prefers-reduced-motion: reduce) { .profile-card:hover, .profile-card:focus-visible { transform: none; } }
</style>
