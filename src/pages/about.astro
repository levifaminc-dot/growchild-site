---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import HumanitarianIcon from "../components/HumanitarianIcon.astro";
import EditorialPhoto from "../components/EditorialPhoto.astro";
import { photos } from "../data/photos";

const values = [
  { title: "Inclusion", text: "Every individual has the right to participate meaningfully in society.", icon: "Affected-population" },
  { title: "Dignity", text: "Respecting the rights, choices, voices, and aspirations of individuals and communities.", icon: "Protection" },
  { title: "Resilience", text: "Strengthening the ability of individuals, households, and communities to withstand shocks and build sustainable futures.", icon: "Resilience" },
  { title: "Accountability", text: "Transparency, responsible resource management, safeguarding, and accountability to affected populations.", icon: "Monitoring" },
  { title: "Evidence and Learning", text: "Reliable data, continuous learning, and evidence-driven decision-making.", icon: "Learning" },
];

const mandate = [
  "Improving access to essential services",
  "Strengthening community resilience",
  "Promoting inclusion of marginalized populations",
  "Supporting women and children's empowerment",
  "Advancing disability inclusion",
  "Strengthening local systems and evidence capacity",
];

interface GovernanceProfile {
  id: string;
  name: string;
  position: string;
  biography: string;
  image?: string;
}

const governanceProfiles: GovernanceProfile[] = [
  { id: "governance-profile-1", name: "Name to be confirmed", position: "Position to be confirmed", biography: "The approved professional biography for this governance member will be added here." },
  { id: "governance-profile-2", name: "Name to be confirmed", position: "Position to be confirmed", biography: "The approved professional biography for this governance member will be added here." },
  { id: "governance-profile-3", name: "Name to be confirmed", position: "Position to be confirmed", biography: "The approved professional biography for this governance member will be added here." },
];
---
<BaseLayout title="About Us" description="Learn about GROWCHILD's journey, vision, mission, values and organizational mandate.">
  <PageHero title="About GROWCHILD" intro="Growth and Resilience of Women and Children Empowerment Initiative" parent="About Us" icon="About" photo={photos.womenYouthTownhall} />
  <section class="section">
    <div class="container profile-grid">
      <div><span class="eyebrow">Institutional profile</span><h2>Overview</h2></div>
      <div class="prose"><p>GROWCHILD is a Nigerian women and youth-led humanitarian and development organization committed to improving the wellbeing, dignity, protection, inclusion, and resilience of vulnerable populations, particularly women, children, persons with disabilities, and underserved communities.</p><EditorialPhoto photo={photos.communityOutreach} ratio="wide" class="profile-photo" /></div>
    </div>
  </section>
  <section class="section section-tint">
    <div class="container">
      <span class="eyebrow">Timeline</span><h2 class="section-title">Our Journey</h2>
      <div class="timeline">
        <article><strong>2017</strong><p>Conceptualized as a grassroots response to the increasing challenges affecting women, children, and vulnerable households in crisis-affected and underserved communities, particularly in Northern Nigeria.</p></article>
        <article><strong>2026</strong><p>Formally registered with the Corporate Affairs Commission (CAC), Nigeria, under Registration Number RC: 9704884.</p></article>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container vision-grid">
      <article class="statement vision"><span>Our Vision</span><h2>A Nigeria where everyone can participate.</h2><p>A Nigeria where women, children, persons with disabilities, and vulnerable communities live with dignity, resilience, equal opportunities, and the ability to actively participate in decisions affecting their lives.</p></article>
      <article class="statement mission"><span>Our Mission</span><h2>Strengthen capacity and resilience.</h2><p>To strengthen the capacity and resilience of vulnerable communities through inclusive humanitarian and development interventions that promote protection, empowerment, access to services, evidence-based programming, and locally led solutions.</p></article>
    </div>
  </section>
  <section class="section section-tint">
    <div class="container"><span class="eyebrow">What guides us</span><h2 class="section-title">Our Core Values</h2><div class="values-grid">{values.map((value, i) => <article class="card"><div class="value-mark"><HumanitarianIcon name={value.icon} variant="compact" /><span class="number">0{i+1}</span></div><h3>{value.title}</h3><p>{value.text}</p></article>)}</div></div>
  </section>
  <section class="section">
    <div class="container mandate-grid">
      <div><span class="eyebrow">Organizational mandate</span><h2>Our institutional commitments.</h2><p>Our core programmatic focus areas and institutional commitments.</p></div>
      <ul>{mandate.map((item) => <li>{item}</li>)}</ul>
    </div>
  </section>
  <section class="section leadership">
    <div class="container">
      <header class="leadership-heading">
        <h2>Our Governance</h2>
        <p>Governance profiles will introduce the people responsible for organizational oversight and accountability.</p>
        <span aria-hidden="true"></span>
      </header>
      <div class="leadership-grid">
        {governanceProfiles.map((profile) => (
          <article class="governance-profile">
            <button class="profile-card" type="button" data-biography-target={profile.id} aria-haspopup="dialog" aria-controls={profile.id}>
              <span class="profile-photo-frame">
                {profile.image ? <img src={profile.image} alt={`Portrait of ${profile.name}`} loading="lazy" /> : <span class="profile-photo-slot" role="img" aria-label={`Portrait photograph for ${profile.name} to be added`}><span>Portrait photograph</span><small>To be added</small></span>}
              </span>
              <span class="profile-copy"><strong>{profile.name}</strong><span>{profile.position}</span></span>
              <span class="sr-only">View biography</span>
            </button>
            <dialog id={profile.id} aria-labelledby={`${profile.id}-title`}>
              <div class="biography-dialog">
                <form method="dialog"><button class="dialog-close" type="submit" aria-label="Close biography">×</button></form>
                <span class="profile-label">Governance profile</span>
                <h3 id={`${profile.id}-title`}>{profile.name}</h3>
                <p class="dialog-position">{profile.position}</p>
                <p>{profile.biography}</p>
              </div>
            </dialog>
          </article>
        ))}
      </div>
      <div class="registration">Registered with the Corporate Affairs Commission, Nigeria. RC 9704884 <a href="/safeguarding/">Read our safeguarding commitment →</a></div>
    </div>
  </section>
  <script>
    document.querySelectorAll<HTMLButtonElement>("[data-biography-target]").forEach((button) => {
      button.addEventListener("click", () => {
        const dialog = document.getElementById(button.dataset.biographyTarget || "");
        if (dialog instanceof HTMLDialogElement) dialog.showModal();
      });
    });
  </script>
</BaseLayout>
<style>
  .profile-grid, .mandate-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(2rem,7vw,6rem); }
  .profile-grid h2, .section-title, .mandate-grid h2 { margin-top: .8rem; }
  .prose { font-size: 1.25rem; }
  :global(.profile-photo) { margin-top: 2rem; }
  .timeline { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 3rem; }
  .timeline::before { content: ""; position: absolute; top: 2rem; left: 1rem; right: 1rem; height: 2px; background: var(--border); }
  .timeline article { position: relative; padding: 4rem 2rem 2rem; border: 1px solid var(--border); border-radius: .75rem; background: var(--white); }
  .timeline strong { position: absolute; top: .85rem; left: 2rem; color: var(--royal-purple); font: 700 1.45rem Poppins,Arial,sans-serif; }
  .vision-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  .statement { padding: clamp(2rem,5vw,4rem); border-radius: 1rem; }
  .statement span { display: block; margin-bottom: 1.5rem; font: 700 .9rem Poppins,Arial,sans-serif; letter-spacing: .12em; text-transform: uppercase; }
  .statement h2 { font-size: clamp(1.75rem,3vw,2.6rem); }
  .statement p { margin-top: 1.25rem; }
  .vision { color: var(--white); background: var(--deep-green); }
  .vision h2 { color: var(--white); }
  .mission { border: 1px solid var(--border); background: var(--surface-tint); }
  .values-grid { display: grid; grid-template-columns: repeat(5,1fr); gap: 1rem; margin-top: 3rem; }
  .value-mark { display: flex; align-items: flex-start; justify-content: flex-end; gap: 1rem; margin-bottom: 1.5rem; }
  .number { display: block; color: var(--royal-purple); font: 700 .8rem Poppins,Arial,sans-serif; letter-spacing: .12em; }
  .card p { margin-top: .75rem; font-size: 1rem; }
  .mandate-grid > div > p { margin-top: 1rem; }
  .mandate-grid ul { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; margin: 0; padding: 0; list-style: none; }
  .mandate-grid li { position: relative; padding: 1rem 1rem 1rem 3rem; border: 1px solid var(--border); border-radius: .6rem; }
  .mandate-grid li::before { content: "✓"; position: absolute; left: 1rem; color: var(--leaf-green-dark); font-weight: 700; }
  .leadership { background: #fbfcfb; }
  .leadership-heading { max-width: 42rem; margin-inline: auto; text-align: center; }
  .leadership-heading h2 { color: #171b18; font-size: clamp(2rem,4vw,3rem); font-weight: 500; letter-spacing: -.03em; }
  .leadership-heading p { max-width: 36rem; margin: 1rem auto 0; color: #59625c; }
  .leadership-heading > span { display: block; width: 10rem; height: 1px; margin: 2rem auto 0; background: var(--border); }
  .leadership-grid { display: grid; grid-template-columns: repeat(3,minmax(0,15rem)); justify-content: center; gap: clamp(1rem,3vw,2rem); margin-top: 3rem; }
  .governance-profile { min-width: 0; }
  .profile-card { display: grid; width: 100%; min-height: 100%; padding: 0; overflow: hidden; color: var(--slate-grey); text-align: left; border: 0; border-bottom: 3px solid var(--deep-blue); border-radius: .25rem; background: var(--white); box-shadow: 0 8px 26px rgba(15,38,25,.08); cursor: pointer; font: inherit; transition: box-shadow 200ms ease, transform 200ms ease; }
  .profile-card:hover, .profile-card:focus-visible { box-shadow: 0 18px 38px rgba(15,38,25,.15); transform: translateY(-5px); }
  .profile-photo-frame { display: block; aspect-ratio: 4 / 4.25; overflow: hidden; background: linear-gradient(180deg,#fff 0%,#eef1ef 100%); }
  .profile-photo-frame > img { width: 100%; height: 100%; object-fit: cover; object-position: center top; }
  .profile-photo-slot { display: grid; width: 100%; height: 100%; place-content: center; gap: .2rem; color: #69736c; text-align: center; background: linear-gradient(180deg,#fff,#e7ebe8); }
  .profile-photo-slot span { font: 600 .78rem Poppins,Arial,sans-serif; letter-spacing: .05em; text-transform: uppercase; }
  .profile-photo-slot small { font-size: .75rem; }
  .profile-copy { display: grid; align-content: start; gap: .25rem; padding: 1rem 1rem 1.1rem; }
  .profile-copy strong { color: #171b18; font-family: Poppins,Arial,sans-serif; font-size: 1rem; font-weight: 600; }
  .profile-copy > span { color: #68716b; font-size: .82rem; }
  .profile-label { color: var(--royal-purple); font: 700 .75rem Poppins,Arial,sans-serif; letter-spacing: .1em; text-transform: uppercase; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  dialog { width: min(34rem,calc(100% - 2rem)); padding: 0; color: var(--slate-grey); border: 0; border-radius: 1rem; box-shadow: 0 1.5rem 5rem rgba(0,0,0,.28); }
  dialog::backdrop { background: rgba(3,28,13,.72); backdrop-filter: blur(4px); }
  .biography-dialog { position: relative; display: grid; gap: .75rem; padding: clamp(1.75rem,5vw,3rem); }
  .biography-dialog h3 { padding-right: 2.5rem; font-size: clamp(1.4rem,3vw,2rem); }
  .biography-dialog > p:last-child { margin-top: .5rem; }
  .dialog-position { color: var(--leaf-green-dark); font-family: Poppins,Arial,sans-serif; font-weight: 700; }
  .dialog-close { position: absolute; inset: 1rem 1rem auto auto; display: grid; width: 2.5rem; aspect-ratio: 1; place-items: center; color: var(--deep-green); border: 1px solid var(--border); border-radius: 50%; background: var(--surface-tint); cursor: pointer; font-size: 1.5rem; line-height: 1; }
  .dialog-close:hover, .dialog-close:focus-visible { color: var(--white); border-color: var(--deep-green); background: var(--deep-green); }
  .registration { display: flex; justify-content: space-between; gap: 1rem; margin-top: 1.5rem; padding: 1.25rem; border-radius: .75rem; color: var(--white); background: var(--deep-green); }
  .registration a { font-weight: 700; }
  @media (max-width: 64rem) { .values-grid { grid-template-columns: repeat(2,1fr); } }
  @media (max-width: 48rem) { .profile-grid, .mandate-grid, .vision-grid { grid-template-columns: 1fr; } .timeline { grid-template-columns: 1fr; } .timeline::before { display: none; } .leadership-grid { grid-template-columns: repeat(2,minmax(0,15rem)); } .registration { flex-direction: column; } }
  @media (max-width: 38rem) { .values-grid, .mandate-grid ul { grid-template-columns: 1fr; } }
  @media (max-width: 34rem) { .leadership-grid { grid-template-columns: minmax(0,18rem); } }
  @media (prefers-reduced-motion: reduce) { .profile-card:hover, .profile-card:focus-visible { transform: none; } }
</style>
