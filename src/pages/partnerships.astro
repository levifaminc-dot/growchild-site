---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import HumanitarianIcon from "../components/HumanitarianIcon.astro";
import { photos } from "../data/photos";

const models = [
  { title: "Technical Mentorship", text: "Reciprocal capacity exchange fostering institutional maturity, knowledge transfer, and specialist advisory frameworks for sustainable field interventions.", icon: "Training" },
  { title: "Institutional Strengthening", text: "Consolidating governance, internal compliance, risk management systems, and transparent operational protocols aligned with global statutory standards.", icon: "NGO-office" },
  { title: "Joint Learning", text: "Structured peer dialogues, shared reviews, and cross-organizational learning agendas that iteratively refine frontline intervention methodologies.", icon: "Learning" },
  { title: "Programme Collaboration", text: "Co-designed and co-delivered programmatic architectures delivering dignified health, protection, and economic security to women and vulnerable youth.", icon: "Partnership" },
  { title: "Evidence Generation", text: "Rigorously measured empirical research, field data aggregation, and community-led documentation shaping policy, accountability, and discourse.", icon: "Data" },
];
const reasons = ["Nigerian community understanding","Women and youth-led leadership","Disability inclusion commitment","Advocacy and community engagement capacity","Assistive technology interest and fabrication support capacity","Strong MEAL, TPM, and data systems orientation","Commitment to evidence-driven programming"];
const contributions = [
  { title: "Local knowledge", icon: "Country" },
  { title: "Community access", icon: "Community-engagement" },
  { title: "Inclusion expertise", icon: "Affected-population" },
  { title: "Data and MEAL capacity", icon: "Monitoring" },
  { title: "Commitment to locally led solutions", icon: "Leadership" },
];
---
<BaseLayout title="Partnerships" description="Partner with GROWCHILD on inclusive, evidence-driven and locally led humanitarian and development programmes.">
  <PageHero title="Partner With GROWCHILD" intro="GROWCHILD believes sustainable impact requires collaboration between local organizations, government institutions, international partners, communities, and technical experts." parent="Get Involved" icon="Partnership" photo={photos.womenMarket} />
  <section class="section"><div class="container"><span class="eyebrow">Collaboration models</span><h2 class="section-title">Core Value Propositions</h2><div class="models">{models.map((model,i) => <article><div class="model-mark"><HumanitarianIcon name={model.icon} /><span>0{i+1}</span></div><h3>{model.title}</h3><p>{model.text}</p></article>)}</div></div></section>
  <section class="section section-tint"><div class="container why-grid"><div><span class="eyebrow">Why partner with us?</span><h2>GROWCHILD positions itself as a reliable emerging Nigerian partner.</h2></div><ul>{reasons.map((reason) => <li>{reason}</li>)}</ul></div></section>
  <section class="section"><div class="container"><span class="eyebrow">Shared capacity</span><h2 class="section-title">What We Contribute</h2><div class="contributions">{contributions.map((item,i) => <article><div class="model-mark"><HumanitarianIcon name={item.icon} variant="compact" /><span>0{i+1}</span></div><h3>{item.title}</h3></article>)}</div></div></section>
  <section class="partner-cta"><div class="container"><div><h2>Let's build something together</h2><p>Reach out to our partnership and safeguarding team to explore collaborative structures and local impact initiatives.</p></div><a class="button" href="/contact/">Contact Us</a></div></section>
</BaseLayout>
<style>
  .section-title { margin-top: .8rem; }
  .models { display: grid; grid-template-columns: repeat(6,1fr); gap: 1rem; margin-top: 3rem; }
  .models article { grid-column: span 2; padding: 2rem; border: 1px solid var(--border); border-radius: .75rem; }
  .models article:nth-child(4) { grid-column: 2/span 2; }
  .model-mark { display: flex; align-items: flex-start; justify-content: flex-end; gap: .75rem; margin-bottom: 1.5rem; }
  .model-mark > span { display: block; color: var(--royal-purple); font: 700 .8rem Poppins,Arial,sans-serif; letter-spacing: .12em; }
  .models p { margin-top: .75rem; }
  .why-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(2rem,7vw,6rem); }
  .why-grid h2 { margin-top: .8rem; }
  .why-grid ul { display: grid; gap: .65rem; margin: 0; padding: 0; list-style: none; }
  .why-grid li { position: relative; padding: 1rem 1rem 1rem 3rem; border: 1px solid var(--border); border-radius: .65rem; background: var(--white); }
  .why-grid li::before { content: "✓"; position: absolute; left: 1rem; color: var(--leaf-green-dark); font-weight: 700; }
  .contributions { display: grid; grid-template-columns: repeat(5,1fr); gap: .75rem; margin-top: 2.5rem; }
  .contributions article { min-height: 12rem; padding: 1.5rem; border-top: 4px solid var(--leaf-green); border-radius: .5rem; background: var(--surface-tint); }
  .partner-cta { padding-block: 4rem; color: var(--white); background: var(--deep-blue); }
  .partner-cta .container { display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .partner-cta h2 { color: var(--white); }
  .partner-cta p { max-width: 45rem; margin-top: .65rem; }
  .partner-cta .button { color: var(--deep-blue); background: var(--white); }
  @media (max-width: 62rem) { .contributions { grid-template-columns: repeat(2,1fr); } }
  @media (max-width: 50rem) { .models { grid-template-columns: 1fr; } .models article, .models article:nth-child(4) { grid-column: auto; } .why-grid { grid-template-columns: 1fr; } .partner-cta .container { align-items: flex-start; flex-direction: column; } }
  @media (max-width: 36rem) { .contributions { grid-template-columns: 1fr; } }
</style>
