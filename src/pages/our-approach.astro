---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import AboutSubnav from "../components/AboutSubnav.astro";
import { photos } from "../data/photos";

const advantages = [
  { title: "Evidence-driven", text: "We use quantitative and qualitative evidence to guide decisions, adapt implementation and strengthen public accountability.", items: ["Monitoring, Evaluation, Accountability and Learning", "Third-Party Monitoring", "Digital data collection and validation", "Data quality assurance", "Learning products"] },
  { title: "Community-based", text: "Communities and local leadership help define priorities, shape delivery and steward sustainable results.", items: ["Participation throughout the programme lifecycle", "Local ownership and stewardship", "Inclusion of marginalized groups", "Accessible feedback mechanisms"] },
  { title: "Women and youth-led", text: "Women and young people participate meaningfully in decisions, implementation and long-term community ownership.", items: ["Inclusive decision-making", "Meaningful youth participation", "Women's social and economic empowerment", "Community ownership and autonomy"] },
];

const meal = [
  { title: "Monitoring", activities: ["Indicator tracking", "Activity monitoring", "Field verification", "Third-Party Monitoring"], purpose: "Tracks implementation, verifies results and supports programme quality." },
  { title: "Evaluation", activities: ["Baseline assessments", "Outcome measurement", "Learning reviews"], purpose: "Assesses performance and generates evidence for adaptation." },
  { title: "Accountability", activities: ["Community feedback", "Complaints response", "Satisfaction monitoring"], purpose: "Ensures communities can raise concerns and influence improvement." },
  { title: "Learning", activities: ["Evidence documentation", "Lessons learned", "Case studies", "Knowledge products"], purpose: "Turns programme experience into stronger future practice." },
];

const pathway = [
  { title: "Community identification and screening", text: "Identify persons with disabilities at risk of exclusion due to poverty, location, displacement, stigma or limited services." },
  { title: "Functional assessment and referral", text: "Build linkages with rehabilitation professionals, health facilities, disability organizations and specialized providers." },
  { title: "Assistive technology and rehabilitation pathways", text: "Support a continuum of care focused on clinical accuracy, personalized fit and long-term sustainability." },
];

const processSteps = [
  ["01", "Identify needs", "Listen to communities and understand local priorities."],
  ["02", "Design together", "Co-create inclusive solutions with communities and partners."],
  ["03", "Implement", "Deliver programmes with quality, safeguarding and local ownership."],
  ["04", "Monitor", "Track progress, feedback and results throughout delivery."],
  ["05", "Learn and adapt", "Use evidence to improve decisions and future programmes."],
];
---

<BaseLayout title="Our Approach" description="GROWCHILD combines evidence, community ownership and inclusive leadership to deliver sustainable outcomes.">
  <PageHero title="Our Approach" intro="Evidence, community ownership and inclusive leadership guide how we design, deliver and improve every programme." parent="About Us" photo={photos.medicineOutreach} />
  <AboutSubnav />

  <section class="process-overview" aria-labelledby="process-title">
    <div class="container"><div class="process-heading"><span class="eyebrow">Process at a glance</span><h2 id="process-title">A clear path from listening to learning.</h2></div><ol>{processSteps.map(([number,title,text]) => <li><span>{number}</span><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol></div>
  </section>

  <section class="section" id="delivery-principles">
    <div class="container">
      <div class="section-heading"><span class="eyebrow">How we work</span><h2>Three principles guide delivery.</h2><p>Each principle connects technical quality with local leadership and practical accountability.</p></div>
      <div class="advantage-grid">
        {advantages.map((item,index) => <article><span class="item-number">0{index + 1}</span><h3>{item.title}</h3><p>{item.text}</p><ul>{item.items.map((value) => <li>{value}</li>)}</ul></article>)}
      </div>
    </div>
  </section>

  <section class="section section-tint" id="meal">
    <div class="container">
      <div class="section-heading"><span class="eyebrow">MEAL</span><h2>Monitoring, Evaluation, Accountability and Learning.</h2><p>MEAL is a central component of quality programming and responsible decision-making.</p></div>
      <div class="meal-grid">
        {meal.map((item,index) => <article><span class="meal-letter">{"MEAL"[index]}</span><h3>{item.title}</h3><strong>Key activities</strong><ul>{item.activities.map((activity) => <li>{activity}</li>)}</ul><strong>Purpose</strong><p>{item.purpose}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section" id="disability-pathway">
    <div class="container pathway">
      <div class="pathway-intro"><span class="eyebrow">Disability inclusion</span><h2>A dignified technical pathway.</h2><p>Our approach supports accessible and continuous services while involving persons with disabilities in decisions that affect them.</p></div>
      <ol>
        {pathway.map((item,index) => <li><span>0{index + 1}</span><div><h3>{item.title}</h3><p>{item.text}</p></div></li>)}
      </ol>
      <div class="safeguard"><strong>Guiding safeguard</strong><p>Persons with disabilities are engaged not only as beneficiaries, but as active participants in programme design, implementation, monitoring and decision-making.</p></div>
    </div>
  </section>

  <section class="approach-cta"><div class="container"><div><h2>Partner with us on evidence and learning.</h2><p>Collaborate on accountable, locally led programming.</p></div><a class="button" href="/partnerships/">Explore Partnerships</a></div></section>
</BaseLayout>

<style>
  .process-overview { padding-block: clamp(3rem,6vw,4.5rem); border-bottom: 1px solid var(--border); background: var(--white); }
  .process-overview .container { display: grid; grid-template-columns: .72fr 1.28fr; gap: clamp(2rem,6vw,5rem); align-items: start; }
  .process-heading { display: grid; gap: .8rem; }
  .process-heading h2 { font-size: clamp(1.7rem,3vw,2.35rem); }
  .process-overview ol { display: grid; gap: .7rem; margin: 0; padding: 0; list-style: none; }
  .process-overview li { display: grid; grid-template-columns: auto 1fr; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--border); }
  .process-overview li:first-child { padding-top: 0; }
  .process-overview li:last-child { border-bottom: 0; }
  .process-overview li > span { color: var(--royal-purple); font: 700 .875rem var(--font-heading); }
  .process-overview h3 { font-size: 1rem; }
  .process-overview p { margin-top: .25rem; font-size: .95rem; }
  .section-heading { max-width: 52rem; margin-bottom: 2.8rem; }
  .section-heading h2 { margin-top: .8rem; }
  .section-heading p { margin-top: .8rem; color: var(--slate-grey); }
  .advantage-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1rem; }
  .advantage-grid article { padding: 2rem; border: 1px solid var(--border); border-radius: .85rem; background: var(--white); }
  .item-number { display: block; width: fit-content; margin-bottom: 1.3rem; padding: .3rem .6rem; color: var(--royal-purple); border-radius: 999px; background: #f4edf8; font: 700 .8rem Poppins,Arial,sans-serif; letter-spacing: .1em; }
  .advantage-grid h3 { text-transform: capitalize; }
  .advantage-grid p { margin-top: .85rem; color: var(--slate-grey); }
  .advantage-grid ul, .meal-grid ul { display: grid; gap: .5rem; margin: 1.2rem 0 0; padding: 0; list-style: none; }
  .advantage-grid li, .meal-grid li { position: relative; padding-left: 1.4rem; font-size: .94rem; }
  .advantage-grid li::before, .meal-grid li::before { content: "✓"; position: absolute; left: 0; color: var(--leaf-green-dark); font-weight: 700; }
  .meal-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 1rem; }
  .meal-grid article { padding: 1.6rem; border: 1px solid var(--border); border-top: 4px solid var(--deep-blue); border-radius: .75rem; background: var(--white); }
  .meal-letter { display: grid; width: 2.7rem; aspect-ratio: 1; place-items: center; margin-bottom: 1rem; color: var(--white); border-radius: 50%; background: var(--deep-blue); font: 700 1rem Poppins,Arial,sans-serif; }
  .meal-grid strong { display: block; margin-top: 1.3rem; color: var(--deep-green); font-family: var(--font-heading); font-size: .875rem; letter-spacing: .06em; text-transform: uppercase; }
  .meal-grid p { margin-top: .45rem; color: var(--slate-grey); font-size: .94rem; }
  .pathway { display: grid; grid-template-columns: .72fr 1.28fr; gap: 2rem 5rem; }
  .pathway-intro { display: grid; align-content: start; gap: .85rem; }
  .pathway ol { display: grid; gap: .85rem; margin: 0; padding: 0; list-style: none; }
  .pathway li { display: grid; grid-template-columns: auto 1fr; gap: 1rem; padding: 1.5rem; border: 1px solid var(--border); border-radius: .75rem; }
  .pathway li > span { color: var(--royal-purple); font: 700 .78rem Poppins,Arial,sans-serif; letter-spacing: .1em; }
  .pathway li p { margin-top: .55rem; color: var(--slate-grey); }
  .safeguard { grid-column: 1/-1; padding: 1.5rem; color: var(--white); border-radius: .75rem; background: var(--deep-green); }
  .safeguard strong { font-family: Poppins,Arial,sans-serif; text-transform: uppercase; letter-spacing: .08em; }
  .safeguard p { margin-top: .5rem; }
  .approach-cta { padding-block: 4rem; color: var(--white); background: var(--deep-blue); }
  .approach-cta .container { display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .approach-cta h2, .approach-cta p { color: var(--white); }
  .approach-cta p { margin-top: .5rem; opacity: .84; }
  .approach-cta .button { color: var(--deep-blue); background: var(--white); }
  @media (max-width: 64rem) { .meal-grid { grid-template-columns: repeat(2,1fr); } }
  @media (max-width: 56rem) { .process-overview .container, .advantage-grid, .pathway { grid-template-columns: 1fr; } .safeguard { grid-column: auto; } }
  @media (max-width: 42rem) { .meal-grid { grid-template-columns: 1fr; } .approach-cta .container { align-items: flex-start; flex-direction: column; } }
</style>
