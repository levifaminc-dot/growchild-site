---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
interface Props { title: string; description: string; robots?: string; image?: string; ogType?: "website" | "article"; publishedTime?: string; }
const { title, description, robots = "index, follow", image, ogType = "website", publishedTime } = Astro.props;
const siteUrl = "https://growchild-initiative.ifexls.chatgpt.site";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const fullTitle = `${title} | GROWCHILD`;
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "NGO",
  name: "GROWCHILD",
  alternateName: "Growth and Resilience of Women and Children Empowerment Initiative",
  url: siteUrl,
  email: "growchild.org@gmail.com",
  telephone: "+2349134068024",
  areaServed: "Nigeria",
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A4823" />
    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem("growchild-theme");
          const theme = savedTheme === "light" || savedTheme === "dark"
            ? savedTheme
            : window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          document.documentElement.dataset.theme = theme;
          document.documentElement.style.colorScheme = theme;
        } catch {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="GROWCHILD" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {image && <meta property="og:image" content={image} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader />
    <main id="main-content"><slot /></main>
    <SiteFooter />
  </body>
</html>
