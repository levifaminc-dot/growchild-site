---
import { contentTypeLabel, formatNewsDate, getNewsImageUrl, type NewsArticle } from '../lib/sanity';

interface Props { article: NewsArticle; featured?: boolean; }
const { article, featured = false } = Astro.props;
const imageUrl = getNewsImageUrl(article.coverImage, featured ? 1400 : 760, featured ? 820 : 480);
---

<article class:list={["news-card", { featured }]}>
  {imageUrl && <a class="news-card-image" href={`/news/${article.slug}/`} aria-label={`Read ${article.title}`}>
    <img src={imageUrl} alt={article.coverImage.alt ?? ''} width={featured ? 1400 : 760} height={featured ? 820 : 480} loading={featured ? 'eager' : 'lazy'} decoding="async" />
  </a>}
  <div class="news-card-body">
    <div class="news-meta">
      <span>{article.category?.title ?? contentTypeLabel(article.contentType)}</span>
      <time datetime={article.publishedAt}>{formatNewsDate(article.publishedAt)}</time>
    </div>
    <h2><a href={`/news/${article.slug}/`}>{article.title}</a></h2>
    <p>{article.excerpt}</p>
    <a class="text-link" href={`/news/${article.slug}/`}>Read full story <span aria-hidden="true">→</span></a>
  </div>
</article>

<style>
  .news-card { display: grid; min-width: 0; overflow: hidden; border: 1px solid var(--border); border-radius: .9rem; background: var(--white); box-shadow: 0 10px 28px rgba(10,72,35,.06); transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease; }
  .news-card:hover { border-color: #b7ceb9; box-shadow: 0 18px 38px rgba(10,72,35,.12); transform: translateY(-4px); }
  .news-card-image { display: block; aspect-ratio: 19 / 12; overflow: hidden; background: var(--surface-tint); }
  .news-card-image img { width: 100%; height: 100%; object-fit: cover; transition: transform 300ms ease; }
  .news-card:hover .news-card-image img { transform: scale(1.025); }
  .news-card-body { display: grid; align-content: start; gap: .9rem; padding: clamp(1.25rem,3vw,1.75rem); }
  .news-meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .45rem 1rem; color: #5c685f; font-size: .86rem; }
  .news-meta span { color: var(--royal-purple); font-family: var(--font-heading); font-weight: 700; text-transform: uppercase; }
  h2 { font-size: clamp(1.25rem,2.5vw,1.6rem); }
  h2 a { text-decoration: none; }
  h2 a:hover { color: var(--leaf-green-dark); text-decoration: underline; text-underline-offset: .2rem; }
  p { color: #4c5850; }
  .text-link { margin-top: .15rem; }
  .featured { grid-template-columns: 1.12fr .88fr; align-items: stretch; }
  .featured .news-card-image { min-height: 24rem; aspect-ratio: auto; }
  .featured .news-card-body { align-content: center; padding: clamp(1.75rem,5vw,3.5rem); }
  .featured h2 { font-size: clamp(1.7rem,3.8vw,2.65rem); }
  @media (max-width: 48rem) { .featured { grid-template-columns: 1fr; } .featured .news-card-image { min-height: 0; aspect-ratio: 16 / 10; } }
  @media (prefers-reduced-motion: reduce) { .news-card:hover, .news-card:hover .news-card-image img { transform: none; } }
</style>

