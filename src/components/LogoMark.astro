---
interface Props { light?: boolean; }
const { light = false } = Astro.props;
---
<span class:list={["logo-mark", { light }]} aria-label="GROWCHILD">
  <span class="logo-symbol" aria-hidden="true"><span class="canopy"></span><span class="people"></span></span>
  <span class="logo-type"><strong>GROWCHILD</strong><small>Inclusion · Dignity · Resilience</small></span>
</span>
<style>
  .logo-mark { display: inline-flex; align-items: center; gap: .7rem; color: var(--deep-green); }
  .logo-symbol { position: relative; display: block; width: 2.75rem; height: 2.75rem; flex: 0 0 auto; }
  .canopy { position: absolute; inset: .08rem .15rem .7rem; border-radius: 60% 48% 58% 44%; background: var(--leaf-green); transform: rotate(-7deg); }
  .people, .people::before, .people::after { position: absolute; display: block; content: ""; border-radius: 99px; }
  .people { left: 1.25rem; bottom: .05rem; width: .42rem; height: 1.75rem; background: var(--royal-purple); }
  .people::before { left: -.62rem; top: .55rem; width: .42rem; height: 1.1rem; background: var(--deep-blue); transform: rotate(21deg); }
  .people::after { right: -.62rem; top: .35rem; width: .42rem; height: 1.3rem; background: var(--royal-purple); transform: rotate(-24deg); }
  .logo-type { display: grid; line-height: 1.05; }
  strong { font-family: Poppins, Arial, sans-serif; font-size: 1.03rem; letter-spacing: .035em; }
  small { margin-top: .3rem; font-size: .63rem; letter-spacing: .025em; }
  .light { color: var(--white); }
  .light .canopy { background: #a8f46d; }
  @media (max-width: 25rem) { small { display: none; } }
</style>
