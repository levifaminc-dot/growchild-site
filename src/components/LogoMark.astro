---
interface Props { light?: boolean; }
const { light = false } = Astro.props;
---
<span class:list={["logo-mark", { light }]} aria-label="GROWCHILD">
  <span class="logo-visual" aria-hidden="true">
    <img src="/growchild-logo.jpg" alt="" width="1080" height="1080" />
  </span>
  <span class="logo-type"><strong>GROWCHILD</strong><small>Growth and Resilience</small></span>
</span>
<style>
  .logo-mark { display: inline-flex; align-items: center; gap: .7rem; color: var(--deep-green); }
  .logo-visual { display: block; width: 3.8rem; height: 2.72rem; flex: 0 0 auto; overflow: hidden; border-radius: .3rem; background: var(--white); }
  .logo-visual img { width: 3.8rem; height: auto; max-width: none; }
  .logo-type { display: grid; line-height: 1.05; }
  strong { font-family: Poppins, Arial, sans-serif; font-size: 1.03rem; letter-spacing: .035em; }
  small { margin-top: .3rem; font-size: .63rem; letter-spacing: .025em; }
  .light { color: var(--white); }
  .light .logo-visual { width: 4.6rem; height: 4.6rem; padding: .18rem; border-radius: .5rem; }
  .light .logo-visual img { width: 100%; height: 100%; object-fit: contain; }
  @media (max-width: 25rem) { small { display: none; } }
</style>
