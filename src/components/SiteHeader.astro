---
import LogoMark from "./LogoMark.astro";

const pathname = Astro.url.pathname;
const isCurrent = (href: string) => href === "/" ? pathname === "/" : pathname.startsWith(href);
const aboutLinks = [
  { href: "/about/", label: "Overview" },
  { href: "/where-we-work/", label: "Where We Work" },
  { href: "/our-approach/", label: "Our Approach" },
  { href: "/safeguarding/", label: "Safeguarding" },
];
const involvedLinks = [
  { href: "/partnerships/", label: "Partnerships", description: "Institutional collaborations & joint field action" },
  { href: "/resources/", label: "Resources & Knowledge", description: "Programme guidance, learning and institutional resources" },
  { href: "/news/", label: "News & Updates", description: "Verified stories, announcements and programme updates" },
];
---

<header class="site-header">
  <div class="utility-bar">
    <div class="container utility-inner">
      <div class="utility-contacts">
        <a href="mailto:growchild.org@gmail.com">growchild.org@gmail.com</a><span aria-hidden="true">|</span>
        <a href="tel:+2349134068024">+234 913 406 8024</a><span aria-hidden="true">|</span>
        <span>CAC RC 9704884</span>
      </div>
      <div class="utility-actions">
        <span class="motto-label">Inclusion · Dignity · Resilience</span>
        <button class="theme-toggle" type="button" role="switch" aria-checked="false" aria-label="Enable dark mode">
          <span class="theme-symbol" aria-hidden="true">☀</span>
          <span class="theme-track" aria-hidden="true"><span class="theme-thumb"></span></span>
          <span class="theme-symbol" aria-hidden="true">☾</span>
          <span class="sr-only theme-toggle-label">Enable dark mode</span>
        </button>
      </div>
    </div>
  </div>
  <div class="main-bar">
    <div class="container main-inner">
      <a class="brand-link" href="/" aria-label="GROWCHILD home"><LogoMark /></a>
      <nav class="desktop-nav" aria-label="Primary navigation">
        <a class:list={["nav-link", { current: isCurrent("/") }]} href="/" aria-current={isCurrent("/") ? "page" : undefined}>Home</a>
        <details class="nav-group">
          <summary class:list={["nav-link", { current: aboutLinks.some((link) => isCurrent(link.href)) }]}>About Us <span aria-hidden="true">⌄</span></summary>
          <div class="dropdown"><span class="dropdown-label">About Us Menu</span>{aboutLinks.map((link) => <a class:list={{ current: isCurrent(link.href) }} href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>{link.label}</a>)}</div>
        </details>
        <a class:list={["nav-link", { current: isCurrent("/our-work/") }]} href="/our-work/" aria-current={isCurrent("/our-work/") ? "page" : undefined}>Our Work</a>
        <details class="nav-group">
          <summary class:list={["nav-link", { current: involvedLinks.some((link) => isCurrent(link.href)) }]}>Get Involved <span aria-hidden="true">⌄</span></summary>
          <div class="dropdown dropdown-wide"><span class="dropdown-label">Get Involved Menu</span>{involvedLinks.map((link) => <a class:list={{ current: isCurrent(link.href) }} href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}><strong>{link.label}</strong><small>{link.description}</small></a>)}</div>
        </details>
        <a class:list={["nav-link", { current: isCurrent("/contact/") }]} href="/contact/" aria-current={isCurrent("/contact/") ? "page" : undefined}>Contact Us</a>
      </nav>
      <a class="button button-primary header-cta" href="/partnerships/">Partner With Us</a>
      <details class="mobile-menu">
        <summary aria-label="Open navigation"><span aria-hidden="true">☰</span><span>Menu</span></summary>
        <nav aria-label="Mobile navigation">
          <a class:list={["mobile-link", { current: isCurrent("/") }]} href="/" aria-label="Home" aria-current={isCurrent("/") ? "page" : undefined}>Home</a>
          <details class="mobile-group" open={aboutLinks.some((link) => isCurrent(link.href))}>
            <summary aria-label="About Us menu">About Us <span aria-hidden="true">⌄</span></summary>
            <div>{aboutLinks.map((link) => <a class:list={{ current: isCurrent(link.href) }} href={link.href} aria-label={link.label} aria-current={isCurrent(link.href) ? "page" : undefined}>{link.label}</a>)}</div>
          </details>
          <a class:list={["mobile-link", { current: isCurrent("/our-work/") }]} href="/our-work/" aria-label="Our Work" aria-current={isCurrent("/our-work/") ? "page" : undefined}>Our Work</a>
          <details class="mobile-group" open={involvedLinks.some((link) => isCurrent(link.href))}>
            <summary aria-label="Get Involved menu">Get Involved <span aria-hidden="true">⌄</span></summary><div>{involvedLinks.map((link) => <a class:list={{ current: isCurrent(link.href) }} href={link.href} aria-label={link.label} aria-current={isCurrent(link.href) ? "page" : undefined}>{link.label}</a>)}</div>
          </details>
          <a class:list={["mobile-link", { current: isCurrent("/contact/") }]} href="/contact/" aria-label="Contact Us" aria-current={isCurrent("/contact/") ? "page" : undefined}>Contact Us</a>
          <a class="button button-primary mobile-cta" href="/partnerships/" aria-label="Partner With Us">Partner With Us</a>
          <a class="mobile-email" href="mailto:growchild.org@gmail.com" aria-label="Email GROWCHILD">growchild.org@gmail.com</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const navigationDetails = Array.from(document.querySelectorAll<HTMLDetailsElement>(".site-header details"));
  navigationDetails.forEach((details) => {
    details.addEventListener("toggle", () => {
      if (!details.open) return;
      navigationDetails.forEach((other) => {
        if (other !== details && !details.contains(other) && !other.contains(details)) other.open = false;
      });
    });
  });
  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Node)) return;
    navigationDetails.forEach((details) => {
      if (details.open && !details.contains(target)) details.open = false;
    });
  });
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    const openDetails = navigationDetails.find((details) => details.open);
    if (!openDetails) return;
    openDetails.open = false;
    openDetails.querySelector<HTMLElement>("summary")?.focus();
  });

  const themeToggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
  const themeToggleLabel = themeToggle?.querySelector<HTMLElement>(".theme-toggle-label");
  const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

  const applyTheme = (theme: "light" | "dark", persist = false) => {
    document.documentElement.dataset.theme = theme;
    document.documentElement.style.colorScheme = theme;
    const isDark = theme === "dark";
    const nextAction = isDark ? "Enable light mode" : "Enable dark mode";
    themeToggle?.setAttribute("aria-checked", String(isDark));
    themeToggle?.setAttribute("aria-label", nextAction);
    if (themeToggleLabel) themeToggleLabel.textContent = nextAction;
    if (themeColor) themeColor.content = isDark ? "#0C120E" : "#0A4823";
    if (persist) localStorage.setItem("growchild-theme", theme);
  };

  const initialTheme = document.documentElement.dataset.theme === "dark" ? "dark" : "light";
  applyTheme(initialTheme);
  themeToggle?.addEventListener("click", () => {
    applyTheme(document.documentElement.dataset.theme === "dark" ? "light" : "dark", true);
  });
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; box-shadow: 0 4px 24px rgba(10,72,35,.08); }
  .utility-bar { color: var(--white); background: var(--deep-green); font-size: .875rem; }
  .utility-inner { display: flex; min-height: 2.25rem; align-items: center; justify-content: space-between; gap: 1rem; }
  .utility-contacts { display: flex; align-items: center; gap: .75rem; }
  .utility-contacts a { text-decoration: none; }
  .utility-contacts a:hover { text-decoration: underline; text-underline-offset: .18rem; }
  .utility-actions { display: flex; align-items: center; gap: .75rem; }
  .motto-label { color: rgba(255,255,255,.88); font-weight: 600; letter-spacing: .04em; white-space: nowrap; }
  .theme-toggle { display: inline-flex; min-width: 5.5rem; min-height: 2rem; align-items: center; justify-content: center; gap: .35rem; padding: .22rem .45rem; color: var(--white); border: 1px solid rgba(255,255,255,.42); border-radius: 999px; background: rgba(255,255,255,.1); cursor: pointer; transition: border-color 160ms ease, background-color 160ms ease; }
  .theme-toggle:hover { border-color: var(--white); background: rgba(255,255,255,.17); }
  .theme-symbol { font-size: .8rem; line-height: 1; }
  .theme-track { position: relative; width: 2.25rem; height: 1.2rem; border-radius: 999px; background: rgba(255,255,255,.3); box-shadow: inset 0 0 0 1px rgba(255,255,255,.24); }
  .theme-thumb { position: absolute; top: .15rem; left: .15rem; width: .9rem; aspect-ratio: 1; border-radius: 50%; background: var(--white); box-shadow: 0 1px 4px rgba(0,0,0,.28); transition: transform 180ms ease; }
  .theme-toggle[aria-checked="true"] .theme-track { background: var(--royal-purple); }
  .theme-toggle[aria-checked="true"] .theme-thumb { transform: translateX(1.05rem); }
  .main-bar { border-bottom: 1px solid var(--border); background: rgba(255,255,255,.98); backdrop-filter: blur(12px); }
  .main-inner { display: flex; min-height: 5.25rem; align-items: center; gap: 1rem; }
  .brand-link { margin-right: auto; text-decoration: none; }
  .desktop-nav { display: flex; align-items: center; gap: .1rem; }
  .nav-link { position: relative; display: inline-flex; min-height: 3rem; align-items: center; gap: .3rem; padding-inline: .55rem; color: var(--slate-grey); font-size: .875rem; font-weight: 600; text-decoration: none; white-space: nowrap; }
  .nav-link::after { content: ""; position: absolute; inset: auto .55rem .2rem; height: 3px; border-radius: 99px; background: var(--leaf-green-dark); transform: scaleX(0); transform-origin: left; transition: transform 160ms ease; }
  .nav-link:hover, .nav-link.current { color: var(--leaf-green-dark); }
  .nav-link:hover::after, .nav-link.current::after, .nav-group[open] > .nav-link::after { transform: scaleX(1); }
  .nav-group { position: relative; }
  .nav-group > summary { cursor: pointer; list-style: none; }
  .nav-group > summary::-webkit-details-marker { display: none; }
  .nav-group[open] > summary span { transform: rotate(180deg); }
  .nav-group > summary span { display: inline-block; transition: transform 160ms ease; }
  .dropdown { position: absolute; top: calc(100% + .5rem); left: 0; display: grid; width: 14rem; padding: .55rem; border: 1px solid var(--border); border-radius: .5rem; background: var(--white); box-shadow: var(--shadow-soft); }
  .dropdown-wide { width: 17rem; }
  .dropdown-label { padding: .35rem .65rem; color: #68716b; font: 700 .75rem var(--font-heading); letter-spacing: .08em; text-transform: uppercase; }
  .dropdown a { display: grid; min-height: 2.75rem; padding: .65rem; color: var(--deep-green); border-radius: .38rem; font: 500 .9rem var(--font-heading); text-decoration: none; transition: color 160ms ease, background-color 160ms ease, transform 160ms ease; }
  .dropdown a:hover, .dropdown a:focus-visible, .dropdown a.current { color: var(--leaf-green-dark); background: var(--surface-tint); transform: translateX(.2rem); }
  .dropdown small { margin-top: .2rem; color: var(--slate-grey); font: 400 .8rem/1.35 var(--font-body); }
  .header-cta { flex: 0 0 auto; font-size: .9rem; }
  .mobile-menu { display: none; position: relative; }
  .mobile-menu > summary { display: inline-flex; min-height: 2.75rem; align-items: center; gap: .5rem; padding: .55rem .8rem; color: var(--deep-green); border: 2px solid var(--deep-green); border-radius: .5rem; cursor: pointer; font: 700 .9rem var(--font-heading); list-style: none; }
  .mobile-menu > summary::-webkit-details-marker { display: none; }
  .mobile-menu > nav { position: absolute; top: calc(100% + .75rem); right: 0; display: grid; width: min(22rem, calc(100vw - 1.25rem)); gap: .3rem; padding: .85rem; border: 1px solid var(--border); border-radius: .75rem; background: var(--white); box-shadow: var(--shadow-soft); max-height: calc(100vh - 9rem); overflow-y: auto; }
  .mobile-link, .mobile-group > summary { display: flex; min-height: 2.75rem; align-items: center; justify-content: space-between; padding: .55rem .75rem; color: var(--deep-green); border-radius: .45rem; font: 600 .98rem var(--font-heading); text-decoration: none; transition: color 160ms ease, background-color 160ms ease, transform 160ms ease; }
  .mobile-link:hover, .mobile-link:focus-visible, .mobile-link.current { background: var(--surface-tint); transform: translateX(.18rem); }
  .mobile-group { border: 1px solid var(--border); border-radius: .5rem; overflow: hidden; }
  .mobile-group > summary { cursor: pointer; list-style: none; background: #f8faf7; }
  .mobile-group > summary::-webkit-details-marker { display: none; }
  .mobile-group[open] > summary span { transform: rotate(180deg); }
  .mobile-group > div { display: grid; gap: .15rem; padding: .45rem .65rem .65rem; border-top: 1px solid var(--border); }
  .mobile-group a { padding: .45rem .6rem; color: var(--slate-grey); border-radius: .35rem; font-size: .92rem; text-decoration: none; transition: color 160ms ease, background-color 160ms ease, transform 160ms ease; }
  .mobile-group a:hover, .mobile-group a:focus-visible, .mobile-group a.current { color: var(--deep-green); background: var(--white); transform: translateX(.18rem); }
  .mobile-cta { margin-top: .45rem; }
  .mobile-email { padding: .55rem; color: var(--slate-grey); text-align: center; font-size: .875rem; }
  @media (max-width: 72rem) { .desktop-nav, .header-cta { display: none; } .mobile-menu { display: block; } }
  @media (max-width: 42rem) {
    .utility-inner { min-height: 2.35rem; justify-content: space-between; gap: .5rem; font-size: .75rem; }
    .utility-contacts a:first-child, .utility-contacts span { display: none; }
    .utility-contacts { gap: .3rem; }
    .utility-actions { order: -1; gap: .4rem; }
    .motto-label { color: var(--white); letter-spacing: .02em; }
    .theme-toggle { min-width: auto; padding-inline: .35rem; }
    .theme-symbol { display: none; }
    .main-inner { min-height: 4.5rem; }
  }
  @media (max-width: 25rem) { .utility-contacts { display: none; } .utility-inner { justify-content: center; } .motto-label { font-size: .68rem; } }
</style>
