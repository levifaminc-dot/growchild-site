---
interface Props {
  name: string;
  label?: string;
  variant?: "standard" | "compact" | "hero" | "on-dark";
  class?: string;
}

const {
  name,
  label = "",
  variant = "standard",
  class: className,
} = Astro.props;
---

<span class:list={["humanitarian-icon", `humanitarian-icon--${variant}`, className]}>
  <img
    src={`/icons/ocha/${name}.svg`}
    alt={label}
    aria-hidden={label ? undefined : "true"}
    width="48"
    height="48"
    loading="lazy"
  />
</span>

<style>
  .humanitarian-icon {
    display: inline-grid;
    width: 4.25rem;
    aspect-ratio: 1;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid #bfe6f4;
    border-radius: 50%;
    background: #edf9fd;
  }
  img { width: 2.45rem; height: 2.45rem; object-fit: contain; }
  .humanitarian-icon--compact { width: 3.25rem; }
  .humanitarian-icon--compact img { width: 1.85rem; height: 1.85rem; }
  .humanitarian-icon--hero {
    width: clamp(7rem, 14vw, 10rem);
    border-color: rgba(255,255,255,.4);
    background: rgba(255,255,255,.95);
    box-shadow: 0 1.5rem 4rem rgba(0,0,0,.16);
  }
  .humanitarian-icon--hero img { width: 58%; height: 58%; }
  .humanitarian-icon--on-dark { border-color: rgba(255,255,255,.35); background: var(--white); }
</style>
