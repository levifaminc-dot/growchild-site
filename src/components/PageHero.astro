---
import PhotoAttribution from "./PhotoAttribution.astro";
import type { LicensedPhoto } from "../data/photos";

interface Props { title: string; intro: string; parent?: string; icon?: string; photo: LicensedPhoto; }
const { title, intro, parent, photo } = Astro.props;
---
<section class="page-hero">
  <div class="container page-hero-grid">
    <div>
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span>
        {parent && <><span>{parent}</span><span aria-hidden="true">/</span></>}
        <span aria-current="page">{title}</span>
      </nav>
      <h1>{title}</h1>
      <p>{intro}</p>
    </div>
    <figure class="page-hero-photo">
      <img src={photo.src} alt={photo.alt} loading="eager" fetchpriority="high" decoding="async" />
      <PhotoAttribution photo={photo} />
    </figure>
  </div>
</section>

<style>
  .page-hero-grid { display: grid; grid-template-columns: 1.1fr .9fr; align-items: center; gap: clamp(2rem,6vw,5rem); }
  .page-hero-photo { position: relative; min-height: 20rem; aspect-ratio: 4 / 3; margin: 0; overflow: hidden; border: 1px solid rgba(255,255,255,.35); border-radius: 1rem; box-shadow: 0 1.5rem 4rem rgba(0,0,0,.2); }
  .page-hero-photo::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg,transparent 50%,rgba(1,22,10,.28)); pointer-events: none; }
  .page-hero-photo > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  :global(.page-hero-photo .photo-attribution) { z-index: 2; }
  @media (max-width: 50rem) { .page-hero-grid { grid-template-columns: 1fr; } .page-hero-photo { min-height: 16rem; } }
</style>
