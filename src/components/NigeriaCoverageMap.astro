---
import { geoIdentity, geoPath } from "d3-geo";
import rawBoundaryData from "../data/nigeria-states.json";

type BoundaryFeature = {
  type: "Feature";
  properties: { shapeName: string; shapeISO: string };
  geometry: GeoJSON.Geometry;
};

const regionDefinitions = [
  { name: "North-East", slug: "north-east", color: "#D97706", states: ["Adamawa", "Borno", "Yobe"] },
  { name: "North-West", slug: "north-west", color: "#5B7F2B", states: ["Kaduna", "Kano", "Katsina"] },
  { name: "North-Central", slug: "north-central", color: "#006D77", states: ["Benue", "Niger", "Plateau"] },
  { name: "South-West", slug: "south-west", color: "#00609D", states: ["Ogun", "Ondo", "Osun"] },
  { name: "South-East", slug: "south-east", color: "#622B86", states: ["Abia", "Ebonyi", "Imo"] },
  { name: "South-South", slug: "south-south", color: "#C24165", states: ["Bayelsa", "Cross River", "Rivers"] },
];

const priorityStates = new Set(["Adamawa", "Borno", "Yobe"]);
const operationalStates = new Set(regionDefinitions.flatMap((region) => region.states));
const displayName = (name: string) => name === "Abuja Federal Capital Territory" ? "FCT Abuja" : name;
const regionForState = new Map(regionDefinitions.flatMap((region) => region.states.map((state) => [state, region])));

const rawBoundaries = rawBoundaryData as unknown as GeoJSON.FeatureCollection;
const projection = geoIdentity().reflectY(true).fitExtent([[24, 24], [696, 696]], rawBoundaries);
const pathGenerator = geoPath(projection).digits(1);

const states = (rawBoundaries.features as BoundaryFeature[])
  .map((feature) => {
    const name = feature.properties.shapeName;
    const region = regionForState.get(name);
    return {
      name,
      label: displayName(name),
      iso: feature.properties.shapeISO,
      operational: operationalStates.has(name),
      region: region?.name ?? "",
      regionSlug: region?.slug ?? "",
      color: region?.color ?? "#E5ECE5",
      priority: priorityStates.has(name),
      path: pathGenerator(feature) ?? "",
    };
  })
  .sort((a, b) => a.label.localeCompare(b.label));

const clientData = regionDefinitions.map((region) => ({
  ...region,
  states: region.states.map((name) => ({ name, label: displayName(name), priority: priorityStates.has(name) })),
}));
---

<section class="map-explorer" id="nigeria-coverage-map" aria-labelledby="map-title">
  <div class="map-toolbar">
    <div>
      <span class="map-eyebrow">Interactive coverage map</span>
      <h3 id="map-title">Explore Nigeria by region and state</h3>
    </div>
    <div class="region-filters" role="group" aria-label="Filter map by geopolitical region">
      <button type="button" data-region="all" aria-pressed="false">All 18 states</button>
      {regionDefinitions.map((region) => (
        <button type="button" data-region={region.slug} aria-pressed={region.slug === "north-east" ? "true" : "false"} style={`--region-color:${region.color}`}>
          <span aria-hidden="true"></span>{region.name}
        </button>
      ))}
    </div>
  </div>

  <div class="map-layout">
    <div class="map-stage">
      <svg viewBox="0 0 720 720" role="img" aria-labelledby="map-svg-title map-svg-description">
        <title id="map-svg-title">Interactive map of GROWCHILD's 18 operational states in Nigeria</title>
        <desc id="map-svg-description">The 18 operational states are highlighted and selectable. Adamawa, Borno and Yobe use a distinct colour to show the priority focus.</desc>
        <g class="state-layer">
          {states.map((state) => (
            <path
              class:list={["map-state", { "is-operational": state.operational, "is-context": !state.operational, "is-priority": state.priority }]}
              d={state.path}
              data-state={state.operational ? state.name : undefined}
              data-state-label={state.operational ? state.label : undefined}
              data-region={state.operational ? state.regionSlug : undefined}
              data-region-name={state.operational ? state.region : undefined}
              data-priority={state.operational ? String(state.priority) : undefined}
              style={`--region-color:${state.color}`}
              role={state.operational ? "button" : undefined}
              tabindex={state.operational ? "0" : undefined}
              aria-hidden={state.operational ? undefined : "true"}
              aria-label={state.operational ? `${state.label}, ${state.region}${state.priority ? ", priority focus" : ", operational state"}` : undefined}
            >
              {state.operational && <title>{state.label} · {state.region}{state.priority ? " · Priority focus" : " · Operational state"}</title>}
            </path>
          ))}
        </g>
      </svg>
      <div class="map-legend" aria-label="Map legend">
        <span><i class="priority-key" aria-hidden="true"></i> Priority focus</span>
        <span><i class="operational-key" aria-hidden="true"></i> Operational state</span>
        <span><i class="boundary-key" aria-hidden="true"></i> Geographic context</span>
      </div>
      <p class="map-attribution">Administrative boundaries: <a href="https://www.geoboundaries.org/" target="_blank" rel="noreferrer">geoBoundaries</a>, CC BY 4.0.</p>
    </div>

    <aside class="map-detail" aria-live="polite">
      <span class="detail-label">Selected region</span>
      <h3 class="detail-title">North-East</h3>
      <p class="detail-copy">Priority attention includes Borno, Adamawa and Yobe. Select any state on the map or from the list below.</p>
      <div class="state-list" aria-label="States in North-East"></div>
      <p class="coverage-context"><strong>Coverage:</strong> Only the 18 states named in GROWCHILD's organizational profile are highlighted and selectable. Other boundaries remain faint for geographic context.</p>
    </aside>
  </div>
  <script type="application/json" class="map-data" set:html={JSON.stringify(clientData)}></script>
</section>

<script>
  const root = document.querySelector<HTMLElement>("#nigeria-coverage-map");
  if (root) {
    const dataNode = root.querySelector<HTMLScriptElement>(".map-data");
    const regions = JSON.parse(dataNode?.textContent || "[]") as Array<{name:string;slug:string;color:string;states:Array<{name:string;label:string;priority:boolean}>}>;
    const filterButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-region]"));
    const stateShapes = Array.from(root.querySelectorAll<SVGPathElement>(".map-state.is-operational"));
    const detailLabel = root.querySelector<HTMLElement>(".detail-label");
    const detailTitle = root.querySelector<HTMLElement>(".detail-title");
    const detailCopy = root.querySelector<HTMLElement>(".detail-copy");
    const stateList = root.querySelector<HTMLElement>(".state-list");
    let activeRegion = "north-east";
    let activeState = "";

    const selectState = (stateName: string) => {
      const shape = stateShapes.find((candidate) => candidate.dataset.state === stateName);
      if (!shape) return;
      const regionSlug = shape.dataset.region || "";
      if (regionSlug !== activeRegion) selectRegion(regionSlug);
      activeState = stateName;
      stateShapes.forEach((candidate) => candidate.classList.toggle("is-selected", candidate.dataset.state === stateName));
      root.querySelectorAll<HTMLButtonElement>(".state-choice").forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.state === stateName)));
      if (detailLabel) detailLabel.textContent = shape.dataset.priority === "true" ? "Public priority focus" : "Selected state";
      if (detailTitle) detailTitle.textContent = shape.dataset.stateLabel || stateName;
      if (detailCopy) detailCopy.textContent = shape.dataset.priority === "true"
        ? `${shape.dataset.stateLabel} is one of GROWCHILD's three priority focus states in the ${shape.dataset.regionName}.`
        : `${shape.dataset.stateLabel} is one of GROWCHILD's operational states in the ${shape.dataset.regionName}.`;
    };

    const renderStateChoices = (regionSlug: string) => {
      if (!stateList) return;
      stateList.replaceChildren();
      const visibleRegions = regionSlug === "all" ? regions : regions.filter((region) => region.slug === regionSlug);
      visibleRegions.forEach((region) => {
        const group = document.createElement("div");
        group.className = "state-group";
        if (regionSlug === "all") {
          const heading = document.createElement("strong");
          heading.textContent = region.name;
          group.append(heading);
        }
        const choices = document.createElement("div");
        choices.className = "state-choices";
        region.states.forEach((state) => {
          const button = document.createElement("button");
          button.type = "button";
          button.className = "state-choice";
          button.dataset.state = state.name;
          button.setAttribute("aria-pressed", String(activeState === state.name));
          button.textContent = state.label;
          if (state.priority) {
            const marker = document.createElement("span");
            marker.setAttribute("aria-label", "Priority focus");
            marker.textContent = "●";
            button.append(marker);
          }
          button.addEventListener("click", () => selectState(state.name));
          choices.append(button);
        });
        group.append(choices);
        stateList.append(group);
      });
      stateList.setAttribute("aria-label", regionSlug === "all" ? "The 18 operational states grouped by region" : `Operational states in ${visibleRegions[0]?.name || "selected region"}`);
    };

    function selectRegion(regionSlug: string) {
      activeRegion = regionSlug;
      activeState = "";
      filterButtons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.region === regionSlug)));
      stateShapes.forEach((shape) => {
        shape.classList.remove("is-selected");
        shape.classList.toggle("is-muted", regionSlug !== "all" && shape.dataset.region !== regionSlug);
      });
      const region = regions.find((candidate) => candidate.slug === regionSlug);
      if (detailLabel) detailLabel.textContent = region ? "Selected region" : "National view";
      if (detailTitle) detailTitle.textContent = region?.name || "Nigeria's six regions";
      if (detailCopy) detailCopy.textContent = region?.slug === "north-east"
        ? "Priority attention includes Borno, Adamawa and Yobe. Select any state on the map or from the list below."
        : region
          ? `${region.name} has ${region.states.length} listed operational states. Select a state to explore its location.`
          : "Explore GROWCHILD's 18 operational states, grouped across Nigeria's six geopolitical regions.";
      renderStateChoices(regionSlug);
    }

    filterButtons.forEach((button) => button.addEventListener("click", () => selectRegion(button.dataset.region || "all")));
    stateShapes.forEach((shape) => {
      shape.addEventListener("click", () => selectState(shape.dataset.state || ""));
      shape.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          selectState(shape.dataset.state || "");
        }
      });
    });
    selectRegion(activeRegion);
  }
</script>

<style>
  .map-explorer { padding: clamp(1.25rem,3vw,2rem); border: 1px solid var(--border); border-radius: 1.25rem; background: var(--white); box-shadow: var(--shadow-soft); }
  .map-toolbar { display: grid; gap: 1.35rem; padding-bottom: 1.35rem; border-bottom: 1px solid var(--border); }
  .map-toolbar > div:first-child { display: grid; gap: .45rem; }
  .map-eyebrow, .detail-label { color: var(--leaf-green-dark); font: 700 .78rem var(--font-heading); letter-spacing: .1em; text-transform: uppercase; }
  .map-toolbar h3 { font-size: clamp(1.65rem,3vw,2.2rem); }
  .region-filters { display: flex; flex-wrap: wrap; gap: .55rem; }
  .region-filters button, :global(.state-choice) { display: inline-flex; min-height: 2.75rem; align-items: center; gap: .5rem; padding: .55rem .8rem; color: var(--deep-green); border: 1px solid #cbd8cb; border-radius: 999px; background: var(--white); font: 700 .82rem var(--font-heading); cursor: pointer; transition: color 160ms ease, background-color 160ms ease, border-color 160ms ease, transform 160ms ease; }
  .region-filters button:hover, :global(.state-choice:hover) { transform: translateY(-2px); border-color: var(--deep-green); }
  .region-filters button[aria-pressed="true"], :global(.state-choice[aria-pressed="true"]) { color: var(--white); border-color: var(--deep-green); background: var(--deep-green); }
  .region-filters button > span { width: .75rem; aspect-ratio: 1; border-radius: 50%; background: var(--region-color); box-shadow: 0 0 0 1px rgba(0,0,0,.12); }
  .map-layout { display: grid; grid-template-columns: minmax(0,1.2fr) minmax(18rem,.8fr); gap: clamp(1.5rem,4vw,3rem); align-items: start; margin-top: 1.5rem; }
  .map-stage svg { width: 100%; height: auto; max-height: 42rem; overflow: visible; }
  .map-state { fill: #e7eee7; stroke: var(--white); stroke-width: 1.5; vector-effect: non-scaling-stroke; transition: fill-opacity 160ms ease, filter 160ms ease, opacity 160ms ease, stroke-width 160ms ease; }
  .map-state.is-operational { fill: var(--deep-blue); fill-opacity: .82; cursor: pointer; }
  .map-state.is-operational:hover, .map-state.is-operational:focus-visible { fill-opacity: 1; filter: drop-shadow(0 4px 5px rgba(10,72,35,.2)); outline: none; stroke-width: 3; }
  .map-state.is-context { fill: #e7eee7; stroke: #fff; }
  .map-state.is-muted { opacity: .18; }
  .map-state.is-priority { fill: var(--royal-purple); fill-opacity: 1; stroke: #f3c45a; stroke-width: 3; filter: drop-shadow(0 0 4px rgba(98,43,134,.55)); }
  .map-state.is-selected { stroke: #171b18; stroke-width: 4; filter: drop-shadow(0 5px 7px rgba(0,0,0,.28)); opacity: 1; }
  .map-legend { display: flex; flex-wrap: wrap; gap: .75rem 1.25rem; margin-top: .75rem; color: #566159; font-size: .86rem; }
  .map-legend span { display: inline-flex; align-items: center; gap: .45rem; }
  .map-legend i { display: inline-block; width: 1.1rem; aspect-ratio: 1; }
  .priority-key { border: 3px solid #f3c45a; border-radius: .2rem; background: var(--royal-purple); }
  .operational-key { border: 2px solid var(--white); border-radius: .2rem; background: var(--deep-blue); box-shadow: 0 0 0 1px #b9c6ba; }
  .boundary-key { border: 2px solid #b9c6ba; border-radius: .2rem; background: #e7eee7; }
  .map-attribution { margin-top: .7rem; color: #68736b; font-size: .78rem; }
  .map-attribution a { text-underline-offset: .18rem; }
  .map-detail { position: sticky; top: 10rem; display: grid; gap: .8rem; padding: clamp(1.35rem,3vw,2rem); border-radius: 1rem; color: var(--white); background: linear-gradient(145deg,var(--deep-green),#0d6630); }
  .map-detail .detail-label { color: #d4f1c0; }
  .map-detail h3 { color: var(--white); font-size: clamp(2rem,4vw,3rem); }
  .detail-copy { color: rgba(255,255,255,.88); }
  :global(.state-list) { display: grid; gap: 1rem; margin-top: .35rem; }
  :global(.state-group) { display: grid; gap: .55rem; }
  :global(.state-group > strong) { color: #d4f1c0; font: 700 .78rem var(--font-heading); letter-spacing: .08em; text-transform: uppercase; }
  :global(.state-choices) { display: flex; flex-wrap: wrap; gap: .45rem; }
  :global(.state-choice) { min-height: 2.5rem; padding: .45rem .68rem; color: var(--deep-green); background: rgba(255,255,255,.95); font-size: .78rem; }
  :global(.state-choice span) { color: #e4a316; font-size: .7rem; }
  .coverage-context { margin-top: .5rem; padding-top: 1rem; color: rgba(255,255,255,.75); border-top: 1px solid rgba(255,255,255,.18); font-size: .84rem; line-height: 1.5; }
  .coverage-context strong { color: var(--white); }
  @media (max-width: 58rem) { .map-layout { grid-template-columns: 1fr; } .map-detail { position: static; } .map-stage svg { max-height: 36rem; } }
  @media (max-width: 38rem) { .map-explorer { padding: 1rem; border-radius: .85rem; } .region-filters { display: grid; grid-template-columns: 1fr 1fr; } .region-filters button { justify-content: flex-start; border-radius: .55rem; } .map-stage svg { max-height: none; } .map-detail { padding: 1.25rem; } }
  @media (prefers-reduced-motion: reduce) { .map-state, .region-filters button, :global(.state-choice) { transition: none; } }
</style>
